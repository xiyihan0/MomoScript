+        assert_eq!(svg_fixed_3(10.00051), Some(10.001));
+        assert_eq!(svg_shortest(0.1), Some(0.1));
+        assert_ne!(f64::from(0.1f32), svg_shortest(0.1).unwrap());
+
+        let source = Source::detached("x");
+        let id = source.id();
+        let span = source.root().span();
+        let size = Size::splat(Abs::pt(100.0));
+        let geometry = test_geometry(source, size, vec![cluster(id, span, 0..1, 10.0, 1.0, 40.0)]);
+        let before = PreviewPoint {
+            page_index: 0,
+            x: 9.9996 / 100.0,
+            y: 0.45,
+        };
+        let after = PreviewPoint {
+            page_index: 0,
+            x: 11.0004 / 100.0,
+            y: 0.45,
+        };
+        assert!(geometry
+            .hit_test(before, uncertainty(0.0, 0.0), PositionEncoding::Utf16)
