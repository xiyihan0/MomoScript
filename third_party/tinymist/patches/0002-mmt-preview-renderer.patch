+    fn literal_origin(source: &Source) -> TextOrigin {
+        fn call(node: typst::syntax::LinkedNode<'_>) -> Option<Span> {
+            if node.kind() == SyntaxKind::FuncCall {
+                return Some(node.span());
+            }
+            node.children().find_map(call)
+        }
+        TextOrigin::from_source(source, call(LinkedNode::new(source.root())).unwrap()).unwrap()
+    }
