+                PositionEncoding::Utf16,
+            )
+            .is_none());
+        let competing = cluster(id, span, 1..2, observed_x - 0.001, 0.00075, 50.0);
+        let ambiguous = test_geometry(source, size, vec![target(), competing]);
+        assert!(ambiguous
+            .hit_test(
+                point(observed_x),
+                uncertainty(0.0003 / page_width, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .is_none());
