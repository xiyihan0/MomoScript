+pub(crate) enum PreviewRendererParams {
+    #[serde(rename = "register")]
+    Register {
+        protocol_version: String,
+        session_id: String,
+        entry_uri: Url,
+        render_entry_uri: Url,
+        source_digest: String,
+        mounts: Vec<PreviewRendererMount>,
+        #[serde(default)]
+        font_digests: Vec<String>,
+        files: Vec<PreviewRendererFileRecord>,
+    },
+    #[serde(rename = "render")]
+    Render {
+        protocol_version: String,
+        session_id: String,
+        snapshot_token: String,
+        source_digest: String,
+        base_generation: Option<u64>,
+        #[serde(default)]
+        force_full: bool,
+    },
+    #[serde(rename = "commit")]
+    Commit {
+        protocol_version: String,
+        session_id: String,
+        snapshot_token: String,
+        generation: u64,
+    },
+    #[serde(rename = "discard")]
+    Discard {
+        protocol_version: String,
+        session_id: String,
+        snapshot_token: String,
+        generation: u64,
+    },
+    #[serde(rename = "locatePoint")]
+    LocatePoint {
+        protocol_version: String,
+        session_id: String,
+        generation: u64,
+        position: PreviewPoint,
+    },
+    #[serde(rename = "locateSource")]
+    LocateSource {
+        protocol_version: String,
+        session_id: String,
