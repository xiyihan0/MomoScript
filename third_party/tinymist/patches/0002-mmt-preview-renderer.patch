+impl ServerState {
+    pub(crate) fn preview_renderer(&mut self, params: PreviewRendererParams) -> ScheduleResult {
+        validate_params(&params)?;
+        let response = self.preview_renderer_(params)?;
+        let value =
+            serde_json::to_value(response).map_err(|error| internal_error(error.to_string()))?;
+        just_ok(value)
+    }
+
+    fn preview_renderer_(
+        &mut self,
+        params: PreviewRendererParams,
+    ) -> Result<PreviewRendererResponse, sync_ls::ResponseError> {
+        match params {
+            PreviewRendererParams::Register {
+                session_id,
+                entry_uri,
+                render_entry_uri,
+                source_digest,
+                mounts,
+                font_digests,
+                files,
+                ..
+            } => self.preview_renderer_register(
+                session_id,
+                entry_uri,
+                render_entry_uri,
+                source_digest,
+                mounts,
+                font_digests,
+                files,
+            ),
+            PreviewRendererParams::Render {
+                session_id,
+                snapshot_token,
+                source_digest,
+                base_generation,
+                force_full,
+                ..
+            } => self.preview_renderer_render(
+                session_id,
+                snapshot_token,
+                source_digest,
+                base_generation,
+                force_full,
+            ),
+            PreviewRendererParams::Commit {
+                session_id,
+                snapshot_token,
+                generation,
+                ..
+            } => {
+                let state = &mut self.preview_renderer;
+                let last_used = state.touch();
+                let Some(session) = state.sessions.get_mut(&session_id) else {
+                    return Ok(resync(session_id, snapshot_token, None));
+                };
+                session.last_used = last_used;
+                let matches = session.staged.as_ref().is_some_and(|staged| {
+                    staged.state.snapshot_token == snapshot_token
+                        && staged.state.generation == generation
+                });
+                if !matches {
+                    return Ok(resync(
+                        session_id,
+                        snapshot_token,
+                        session.expected_base_generation(),
+                    ));
+                }
+                let staged = session
+                    .staged
+                    .take()
+                    .expect("validated staged renderer generation");
+                session.committed = Some(staged.state);
+                session.committed_renderer = session.staged_renderer.take();
+                Ok(PreviewRendererResponse::Committed {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                    snapshot_token,
+                    generation,
+                })
+            }
+            PreviewRendererParams::Discard {
+                session_id,
+                snapshot_token,
+                generation,
+                ..
+            } => {
+                let state = &mut self.preview_renderer;
+                let last_used = state.touch();
+                let Some(session) = state.sessions.get_mut(&session_id) else {
+                    return Ok(resync(session_id, snapshot_token, None));
+                };
+                session.last_used = last_used;
+                let matches = session.staged.as_ref().is_some_and(|staged| {
+                    staged.state.snapshot_token == snapshot_token
+                        && staged.state.generation == generation
+                });
+                if !matches {
+                    return Ok(resync(
+                        session_id,
+                        snapshot_token,
+                        session.expected_base_generation(),
+                    ));
+                }
+                session.staged = None;
+                session.staged_renderer = None;
+                Ok(PreviewRendererResponse::Discarded {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                    snapshot_token,
+                    generation,
+                })
+            }
+            PreviewRendererParams::LocatePoint {
+                session_id,
+                generation,
+                position,
+                ..
+            } => {
+                let encoding = self.const_config().position_encoding;
+                let state = &mut self.preview_renderer;
+                let last_used = state.touch();
+                let Some(session) = state.sessions.get_mut(&session_id) else {
+                    return Ok(PreviewRendererResponse::Unavailable {
+                        protocol_version: PROTOCOL_VERSION,
+                        session_id,
+                        generation,
+                    });
+                };
+                session.last_used = last_used;
+                let Some(committed) = session
+                    .committed
+                    .as_ref()
+                    .filter(|state| state.generation == generation)
+                else {
+                    return Ok(PreviewRendererResponse::Unavailable {
+                        protocol_version: PROTOCOL_VERSION,
+                        session_id,
+                        generation,
+                    });
+                };
+                let location = committed.artifact.doc.as_ref().and_then(|document| {
+                    preview_location_for_snapshot(
+                        committed.artifact.world(),
+                        document,
+                        encoding,
+                        committed.entry_uri.clone(),
+                        position,
+                    )
+                });
+                Ok(PreviewRendererResponse::LocatedPoint {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                    generation,
+                    location,
+                })
+            }
+            PreviewRendererParams::LocateSource {
+                session_id,
+                generation,
+                uri,
+                position,
+                ..
+            } => {
+                let encoding = self.const_config().position_encoding;
+                let state = &mut self.preview_renderer;
+                let last_used = state.touch();
+                let Some(session) = state.sessions.get_mut(&session_id) else {
+                    return Ok(PreviewRendererResponse::Unavailable {
+                        protocol_version: PROTOCOL_VERSION,
+                        session_id,
+                        generation,
+                    });
+                };
+                session.last_used = last_used;
+                let Some(committed) = session
+                    .committed
+                    .as_ref()
+                    .filter(|state| state.generation == generation)
+                else {
+                    return Ok(PreviewRendererResponse::Unavailable {
+                        protocol_version: PROTOCOL_VERSION,
+                        session_id,
+                        generation,
+                    });
+                };
+                let locations = committed
+                    .artifact
+                    .doc
+                    .as_ref()
+                    .and_then(|document| {
+                        source_locations_for_snapshot(
+                            committed.artifact.world(),
+                            document,
+                            encoding,
+                            uri,
+                            position,
+                        )
+                    })
+                    .unwrap_or_default();
+                Ok(PreviewRendererResponse::LocatedSource {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                    generation,
+                    locations,
+                })
+            }
+            PreviewRendererParams::HitTestText {
+                session_id,
+                generation,
+                position,
+                uncertainty,
+                ..
+            } => Ok(self.preview_renderer_text_geometry(
+                session_id,
+                generation,
+                PreviewTextQuery::HitTest(position, uncertainty),
+            )),
+            PreviewRendererParams::LocateCaret {
+                session_id,
+                generation,
+                uri,
+                position,
+                affinity,
+                ..
+            } => Ok(self.preview_renderer_text_geometry(
+                session_id,
+                generation,
+                PreviewTextQuery::Caret(uri, position, affinity),
+            )),
+            PreviewRendererParams::LocateRange {
+                session_id,
+                generation,
+                uri,
+                range,
+                ..
+            } => Ok(self.preview_renderer_text_geometry(
+                session_id,
+                generation,
+                PreviewTextQuery::Range(uri, range),
+            )),
+            PreviewRendererParams::Close { session_id, .. } => {
+                self.preview_renderer.sessions.remove(&session_id);
+                Ok(PreviewRendererResponse::Closed {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                })
+            }
+        }
+    }
+
+    fn preview_renderer_text_geometry(
+        &mut self,
+        session_id: String,
+        generation: u64,
+        query: PreviewTextQuery,
+    ) -> PreviewRendererResponse {
+        let encoding = self.const_config().position_encoding;
+        let state = &mut self.preview_renderer;
+        let last_used = state.touch();
+        let committed = state.sessions.get_mut(&session_id).and_then(|session| {
+            session.last_used = last_used;
+            session
+                .committed
+                .as_ref()
+                .filter(|state| state.generation == generation)
+        });
+        let geometry = committed.and_then(|committed| {
+            committed
+                .text_geometry
+                .get_or_init(|| {
+                    PreviewTextGeometry::new(
+                        committed.artifact.world(),
+                        committed.artifact.doc.as_ref()?,
+                        &committed.entry_uri,
+                    )
+                })
+                .as_ref()
+                .map(|geometry| (committed, geometry))
+        });
+        let Some((committed, geometry)) = geometry else {
+            return PreviewRendererResponse::Unavailable {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                generation,
+            };
+        };
+        match query {
+            PreviewTextQuery::HitTest(point, uncertainty) => PreviewRendererResponse::TextHit {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                generation,
+                location: geometry.hit_test(point, uncertainty, encoding),
+            },
+            PreviewTextQuery::Caret(uri, position, affinity) => {
+                PreviewRendererResponse::LocatedCaret {
+                    protocol_version: PROTOCOL_VERSION,
+                    session_id,
+                    generation,
+                    carets: geometry.caret(
+                        committed.artifact.world(),
+                        &uri,
+                        position,
+                        affinity,
+                        encoding,
+                    ),
+                }
+            }
+            PreviewTextQuery::Range(uri, range) => PreviewRendererResponse::LocatedRange {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                generation,
+                boxes: geometry.range(committed.artifact.world(), &uri, range, encoding),
+            },
+        }
+    }
+
+    fn preview_renderer_register(
+        &mut self,
+        session_id: String,
+        entry_uri: Url,
+        render_entry_uri: Url,
+        source_digest: String,
+        mounts: Vec<PreviewRendererMount>,
+        font_digests: Vec<String>,
+        files: Vec<PreviewRendererFileRecord>,
+    ) -> Result<PreviewRendererResponse, sync_ls::ResponseError> {
+        let render_path = as_path_(&render_entry_uri);
+        let canonical_entry = canonical_path(&render_path)?;
+        let mount_root = preview_mount_root(&canonical_entry)?;
+        let registered_mounts =
+            validate_preview_mounts(mounts, &canonical_entry, &mount_root, &source_digest)?;
+        let mut referenced = registered_mounts
+            .iter()
+            .map(|mount| mount.content_digest.clone())
+            .collect::<HashSet<_>>();
+        let mut seen_fonts = HashSet::new();
+        for digest in &font_digests {
+            validate_digest("font digest", digest)?;
+            if !seen_fonts.insert(digest.clone()) {
+                return Err(invalid_params(
+                    "preview renderer font digests must be unique",
+                ));
+            }
+            referenced.insert(digest.clone());
+        }
+        let mut seen_files = HashSet::new();
+        let mut decoded_files = Vec::with_capacity(files.len());
+        for file in files {
+            validate_digest("file contentDigest", &file.content_digest)?;
+            if !referenced.contains(&file.content_digest) {
+                return Err(invalid_params(
+                    "preview renderer file record is not referenced by the snapshot",
+                ));
+            }
+            if !seen_files.insert(file.content_digest.clone()) {
+                return Err(invalid_params(
+                    "preview renderer file record digests must be unique",
+                ));
+            }
+            if file.data_base64.len() > MAX_PREVIEW_MOUNT_FILE_BYTES.saturating_mul(2) {
+                return Err(invalid_params(
+                    "preview renderer file exceeds its size limit",
+                ));
+            }
+            let bytes = BASE64
+                .decode(file.data_base64.as_bytes())
+                .map_err(|_| invalid_params("preview renderer file is not valid base64"))?;
+            if bytes.len() > MAX_PREVIEW_MOUNT_FILE_BYTES {
+                return Err(invalid_params(
+                    "preview renderer file exceeds its size limit",
+                ));
+            }
+            if canonical_bytes_digest("mmt-project-file-v1", &[&bytes]) != file.content_digest {
+                return Err(invalid_params(
+                    "preview renderer file content digest does not match its bytes",
+                ));
+            }
+            decoded_files.push((file.content_digest, bytes));
+        }
+
+        {
+            let state = &mut self.preview_renderer;
+            state.ensure_capacity_for(&session_id);
+            for (digest, bytes) in decoded_files {
+                state.cache_file_record(digest, bytes)?;
+            }
+        }
+        let (
+            compatible,
+            current_world,
+            current_digests,
+            current_lengths,
+            current_font_digests,
+            current_base_font_resolver,
+        ) = self
+            .preview_renderer
+            .sessions
+            .get(&session_id)
+            .map(|session| {
+                let compatible = session.registered.as_ref().is_some_and(|registered| {
+                    registered.compiler_entry_uri == entry_uri
+                        && registered.render_entry_uri == render_entry_uri
+                }) && session.live_world.is_some();
+                if compatible {
+                    (
+                        true,
+                        session.live_world.clone(),
+                        session.mount_digests.clone(),
+                        session.mount_byte_lengths.clone(),
+                        session.font_digests.clone(),
+                        session.base_font_resolver.clone(),
+                    )
+                } else {
+                    (
+                        false,
+                        None,
+                        HashMap::new(),
+                        HashMap::new(),
+                        Vec::new(),
+                        None,
+                    )
+                }
+            })
+            .unwrap_or_else(|| {
+                (
+                    false,
+                    None,
+                    HashMap::new(),
+                    HashMap::new(),
+                    Vec::new(),
+                    None,
+                )
+            });
+        let next_digests = registered_mounts
+            .iter()
+            .map(|mount| (mount.path.clone(), mount.content_digest.clone()))
+            .collect::<HashMap<_, _>>();
+        let changed_mounts = registered_mounts
+            .iter()
+            .filter(|mount| current_digests.get(&mount.path) != Some(&mount.content_digest))
+            .cloned()
+            .collect::<Vec<_>>();
+        let fonts_changed = current_font_digests != font_digests;
+        let mut missing = changed_mounts
+            .iter()
+            .filter(|mount| {
+                !self
+                    .preview_renderer
+                    .file_records
+                    .contains_key(&mount.content_digest)
+            })
+            .map(|mount| mount.content_digest.clone())
+            .collect::<Vec<_>>();
+        missing.extend(
+            font_digests
+                .iter()
+                .filter(|digest| !self.preview_renderer.file_records.contains_key(*digest))
+                .cloned(),
+        );
+        missing.sort();
+        missing.dedup();
+        if !missing.is_empty() {
+            return Ok(PreviewRendererResponse::MissingFiles {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                source_digest,
+                content_digests: missing,
+            });
+        }
+        let mut next_lengths = HashMap::with_capacity(registered_mounts.len());
+        let mut project_bytes = 0usize;
+        for mount in &registered_mounts {
+            let byte_length = if current_digests.get(&mount.path) == Some(&mount.content_digest) {
+                *current_lengths.get(&mount.path).ok_or_else(|| {
+                    internal_error("preview renderer live mount length is missing")
+                })?
+            } else {
+                self.preview_renderer
+                    .file_records
+                    .get(&mount.content_digest)
+                    .expect("validated renderer file record")
+                    .byte_length
+            };
+            project_bytes = project_bytes
+                .checked_add(byte_length)
+                .ok_or_else(|| invalid_params("preview renderer project size overflow"))?;
+            if project_bytes > MAX_PREVIEW_MOUNT_TOTAL_BYTES {
+                return Err(invalid_params(
+                    "preview renderer project exceeds its size limit",
+                ));
+            }
+            next_lengths.insert(mount.path.clone(), byte_length);
+        }
+        let mut sized_digests = registered_mounts
+            .iter()
+            .map(|mount| mount.content_digest.as_str())
+            .collect::<HashSet<_>>();
+        for digest in &font_digests {
+            if sized_digests.insert(digest.as_str()) {
+                project_bytes = project_bytes
+                    .checked_add(self.preview_renderer.file_records[digest].byte_length)
+                    .ok_or_else(|| invalid_params("preview renderer project size overflow"))?;
+            }
+        }
+        if project_bytes > MAX_PREVIEW_MOUNT_TOTAL_BYTES {
+            return Err(invalid_params(
+                "preview renderer project exceeds its size limit",
+            ));
+        }
+
+        if compatible
+            && changed_mounts.is_empty()
+            && !fonts_changed
+            && current_digests.len() == next_digests.len()
+        {
+            let state = &mut self.preview_renderer;
+            let last_used = state.touch();
+            let session = state
+                .sessions
+                .get_mut(&session_id)
+                .expect("compatible renderer session");
+            session.last_used = last_used;
+            session.registered = Some(RegisteredPreviewProject {
+                compiler_entry_uri: entry_uri,
+                render_entry_uri,
+                source_digest: source_digest.clone(),
+            });
+            return Ok(PreviewRendererResponse::Registered {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                source_digest,
+            });
+        }
+
+        let render_entry = renderer_entry_state(&canonical_entry, &mount_root)?;
+        let rebuild_world = !changed_mounts.is_empty()
+            || current_digests.len() != next_digests.len()
+            || current_world.is_none();
+        let mut next_world = if rebuild_world {
+            let compiler_path = as_path_(&entry_uri);
+            let mut selected = None;
+            for project in self.project.compiler.projects() {
+                let snap = project.snapshot();
+                let world = snap.world();
+                let Some(compiler_id) = world.id_for_path(&compiler_path) else {
+                    continue;
+                };
+                if world.source(compiler_id).is_err() {
+                    continue;
+                }
+                selected = Some(world.task(TaskInputs {
+                    entry: Some(render_entry.clone()),
+                    inputs: None,
+                }));
+                break;
+            }
+            selected.ok_or_else(|| {
+                internal_error("preview renderer base compiler project is not ready")
+            })?
+        } else {
+            current_world.expect("compatible renderer session has a live world")
+        };
+        let base_font_resolver =
+            current_base_font_resolver.unwrap_or_else(|| next_world.font_resolver.clone());
+        if fonts_changed || rebuild_world {
+            let mut searcher = MemoryFontSearcher::new();
+            for digest in &font_digests {
+                let record = self
+                    .preview_renderer
+                    .file_records
+                    .get(digest)
+                    .expect("validated renderer font record");
+                let previous_count = searcher.fonts.len();
+                searcher.add_memory_font(record.bytes.clone());
+                if searcher.fonts.len() == previous_count {
+                    return Err(invalid_params(
+                        "preview renderer font record is not a valid font",
+                    ));
+                }
+            }
+            searcher.extend(
+                base_font_resolver
+                    .fonts()
+                    .map(|(info, slot)| (info.clone(), slot.clone())),
+            );
+            next_world.font_resolver = Arc::new(searcher.build());
+        }
+        for mount in if rebuild_world {
+            &registered_mounts
+        } else {
+            &changed_mounts
+        } {
+            let record = self
+                .preview_renderer
+                .file_records
+                .get(&mount.content_digest)
+                .expect("validated renderer file record");
+            next_world
+                .map_shadow(&mount.path, record.bytes.clone())
+                .map_err(|error| {
+                    internal_error(format!(
+                        "preview renderer cannot upsert mount '{}': {error}",
+                        mount.path.display()
+                    ))
+                })?;
+        }
+        let state = &mut self.preview_renderer;
+        let last_used = state.touch();
+        let session = state
+            .sessions
+            .entry(session_id.clone())
+            .or_insert_with(|| PreviewRendererSession::new(last_used));
+        session.last_used = last_used;
+        session.live_world = Some(next_world);
+        session.base_font_resolver = Some(base_font_resolver);
+        session.mount_digests = next_digests;
+        session.mount_byte_lengths = next_lengths;
+        session.font_digests = font_digests;
+        session.registered = Some(RegisteredPreviewProject {
+            compiler_entry_uri: entry_uri,
+            render_entry_uri,
+            source_digest: source_digest.clone(),
+        });
+        Ok(PreviewRendererResponse::Registered {
+            protocol_version: PROTOCOL_VERSION,
+            session_id,
+            source_digest,
+        })
+    }
+
+    fn preview_renderer_render(
+        &mut self,
+        session_id: String,
+        snapshot_token: String,
+        source_digest: String,
+        base_generation: Option<u64>,
+        force_full: bool,
+    ) -> Result<PreviewRendererResponse, sync_ls::ResponseError> {
+        let position_encoding = self.const_config().position_encoding;
+        let (compile_world, render_entry_uri, generation) = {
+            let state = &mut self.preview_renderer;
+            state.ensure_capacity_for(&session_id);
+            let last_used = state.touch();
+            let session = state
+                .sessions
+                .entry(session_id.clone())
+                .or_insert_with(|| PreviewRendererSession::new(last_used));
+            session.last_used = last_used;
+            if let Some(staged) = session.staged.as_ref() {
+                let expected_base = if staged.frame_kind == "new" {
+                    None
+                } else {
+                    Some(staged.base_generation)
+                };
+                if staged.state.snapshot_token == snapshot_token
+                    && staged.state.source_digest == source_digest
+                    && expected_base == base_generation
+                    && force_full == (staged.frame_kind == "new")
+                {
+                    return Ok(staged.response(session_id));
+                }
+            }
+            let expected_base_generation = session.expected_base_generation();
+            if !force_full && base_generation != expected_base_generation {
+                return Ok(resync(session_id, snapshot_token, expected_base_generation));
+            }
+            let Some(registered) = session
+                .registered
+                .as_ref()
+                .filter(|project| project.source_digest == source_digest)
+            else {
+                return Ok(resync(session_id, snapshot_token, expected_base_generation));
+            };
+            let Some(live_world) = session.live_world.as_ref() else {
+                return Ok(resync(session_id, snapshot_token, expected_base_generation));
+            };
+            let generation = expected_base_generation
+                .unwrap_or(0)
+                .checked_add(1)
+                .ok_or_else(|| internal_error("preview renderer generation overflow"))?;
+            (
+                live_world.clone(),
+                registered.render_entry_uri.clone(),
+                generation,
+            )
+        };
+        let compiler_revision = compile_world.revision().get();
+        let artifact =
+            LspCompiledArtifact::from_graph(WorldComputeGraph::from_world(compile_world), false);
+        let diagnostics = preview_renderer_diagnostics(&artifact, position_encoding);
+        if artifact.doc.is_none() {
+            return Ok(PreviewRendererResponse::CompileFailed {
+                protocol_version: PROTOCOL_VERSION,
+                session_id,
+                snapshot_token,
+                source_digest,
+                compiler_revision,
+                diagnostics,
+            });
+        }
+        let document = artifact
+            .doc
+            .as_ref()
+            .expect("selected renderer artifact has a document")
+            .clone();
+        let state = &mut self.preview_renderer;
+        let session = state
+            .sessions
+            .get_mut(&session_id)
+            .expect("registered renderer session");
+        let (renderer, frame_kind, frame, response_base_generation) = if force_full
+            || session.committed.is_none()
+        {
+            let mut renderer = IncrSvgDocServer::default();
+            let delta = renderer.pack_delta(&document);
+            let payload = delta.strip_prefix(DIFF_V1_PREFIX).ok_or_else(|| {
+                internal_error("Tinymist incremental renderer produced an invalid initial frame")
+            })?;
+            let mut frame = Vec::with_capacity(NEW_PREFIX.len() + payload.len());
+            frame.extend_from_slice(NEW_PREFIX);
+            frame.extend_from_slice(payload);
+            (renderer, "new", frame, 0)
+        } else {
+            let committed = session
+                .committed
+                .as_ref()
+                .expect("validated committed renderer generation");
+            let Some(mut renderer) = session.committed_renderer.take() else {
+                return Ok(resync(
+                    session_id,
+                    snapshot_token,
+                    session.expected_base_generation(),
+                ));
+            };
+            let frame = renderer.pack_delta(&document);
+            (renderer, "diff-v1", frame, committed.generation)
+        };
+        let expected_prefix = if frame_kind == "new" {
+            NEW_PREFIX
+        } else {
+            DIFF_V1_PREFIX
+        };
+        if !frame.starts_with(expected_prefix) {
+            return Err(internal_error(
+                "Tinymist incremental renderer returned an unknown frame",
+            ));
+        }
+        let artifact_digest = sha256_hex(&frame);
+        let byte_length = frame.len();
+        let page_count = match &document {
+            TypstDocument::Paged(document) => document.pages().len(),
+            TypstDocument::Html(_) => 0,
+        };
+        let staged = StagedPreviewRendererGeneration {
+            state: PreviewRendererGeneration {
+                snapshot_token,
+                source_digest,
+                artifact_digest,
+                compiler_revision,
+                generation,
+                page_count,
+                artifact,
+                entry_uri: render_entry_uri,
+                text_geometry: Arc::new(OnceLock::new()),
+            },
+            base_generation: response_base_generation,
+            frame_kind,
+            data_base64: BASE64.encode(&frame),
+            byte_length,
+            diagnostics,
+        };
+        let response = staged.response(session_id);
+        session.staged_renderer = Some(renderer);
+        session.staged = Some(staged);
+        Ok(response)
+    }
+}
+fn preview_renderer_diagnostics(
+    artifact: &LspCompiledArtifact,
+    position_encoding: tinymist_query::PositionEncoding,
+) -> Vec<PreviewRendererDiagnosticRecord> {
+    let diagnostics = tinymist_query::convert_diagnostics(
+        artifact.graph.clone(),
+        artifact.diagnostics(),
+        position_encoding,
+    );
+    let mut records = diagnostics
+        .into_iter()
+        .flat_map(|(uri, diagnostics)| {
+            diagnostics
+                .into_iter()
+                .map(move |diagnostic| PreviewRendererDiagnosticRecord {
+                    uri: uri.clone(),
+                    diagnostic,
+                })
+        })
+        .collect::<Vec<_>>();
+    records.sort_by(|left, right| {
+        (
+            left.uri.as_str(),
+            left.diagnostic.range.start.line,
+            left.diagnostic.range.start.character,
+            left.diagnostic.range.end.line,
+            left.diagnostic.range.end.character,
+            left.diagnostic.severity,
+            left.diagnostic.message.as_str(),
+        )
+            .cmp(&(
+                right.uri.as_str(),
+                right.diagnostic.range.start.line,
+                right.diagnostic.range.start.character,
+                right.diagnostic.range.end.line,
+                right.diagnostic.range.end.character,
+                right.diagnostic.severity,
+                right.diagnostic.message.as_str(),
+            ))
+    });
+    records
+}
+
+fn resync(
+    session_id: String,
+    snapshot_token: String,
+    expected_base_generation: Option<u64>,
+) -> PreviewRendererResponse {
+    PreviewRendererResponse::Resync {
+        protocol_version: PROTOCOL_VERSION,
+        session_id,
+        snapshot_token,
+        expected_base_generation,
+    }
+}
+
+fn validate_params(params: &PreviewRendererParams) -> Result<(), sync_ls::ResponseError> {
+    let (protocol_version, session_id) = match params {
+        PreviewRendererParams::Register {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::Render {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::Commit {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::Discard {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::LocatePoint {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::LocateSource {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::HitTestText {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::LocateCaret {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::LocateRange {
+            protocol_version,
+            session_id,
+            ..
+        }
+        | PreviewRendererParams::Close {
+            protocol_version,
+            session_id,
+        } => (protocol_version, session_id),
+    };
+    if protocol_version != PROTOCOL_VERSION {
+        return Err(invalid_params(
+            "unsupported preview renderer protocolVersion",
+        ));
+    }
+    if session_id.is_empty()
+        || session_id.len() > 128
+        || !session_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return Err(invalid_params(
+            "preview renderer sessionId must be 1-128 safe ASCII characters",
+        ));
+    }
+    match params {
+        PreviewRendererParams::Register {
+            source_digest,
+            mounts,
+            font_digests,
+            files,
+            ..
+        } => {
+            validate_digest("sourceDigest", source_digest)?;
+            if mounts.len() > MAX_PREVIEW_MOUNT_FILES
+                || font_digests.len() > MAX_PREVIEW_FONT_FILES
+                || files.len() > MAX_PREVIEW_MOUNT_FILES + MAX_PREVIEW_FONT_FILES
+            {
+                return Err(invalid_params(
+                    "preview renderer registration file count exceeds its limit",
+                ));
+            }
+        }
+        PreviewRendererParams::Render {
+            snapshot_token,
+            source_digest,
+            base_generation,
+            force_full,
+            ..
+        } => {
+            validate_digest("snapshotToken", snapshot_token)?;
+            validate_digest("sourceDigest", source_digest)?;
+            if *force_full && base_generation.is_some() {
+                return Err(invalid_params(
+                    "forceFull preview renderer requests must not specify baseGeneration",
+                ));
+            }
+        }
+        PreviewRendererParams::Commit {
+            snapshot_token,
+            generation,
+            ..
+        }
+        | PreviewRendererParams::Discard {
+            snapshot_token,
+            generation,
+            ..
+        } => {
+            validate_digest("snapshotToken", snapshot_token)?;
+            if *generation == 0 {
+                return Err(invalid_params(
+                    "preview renderer generation must be positive",
+                ));
+            }
+        }
+        PreviewRendererParams::LocatePoint {
+            generation,
+            position,
+            ..
+        } => {
+            if *generation == 0
+                || !position.x.is_finite()
+                || !position.y.is_finite()
+                || !(0.0..=1.0).contains(&position.x)
+                || !(0.0..=1.0).contains(&position.y)
+            {
+                return Err(invalid_params("invalid generation-bound preview point"));
+            }
+        }
+        PreviewRendererParams::HitTestText {
+            generation,
+            position,
+            uncertainty,
+            ..
+        } => {
+            if *generation == 0
+                || !position.x.is_finite()
+                || !position.y.is_finite()
+                || !(0.0..=1.0).contains(&position.x)
+                || !(0.0..=1.0).contains(&position.y)
+            {
+                return Err(invalid_params("invalid generation-bound preview point"));
+            }
+            if !uncertainty.x.is_finite()
+                || !uncertainty.y.is_finite()
+                || !(0.0..=1.0).contains(&uncertainty.x)
+                || !(0.0..=1.0).contains(&uncertainty.y)
+            {
+                return Err(invalid_params(
+                    "preview text hit uncertainty must have finite normalized components",
+                ));
+            }
+        }
+        PreviewRendererParams::LocateRange { range, .. } if range.start > range.end => {
+            return Err(invalid_params("preview text range must be source-ordered"));
+        }
+        PreviewRendererParams::LocateSource { generation, .. }
+        | PreviewRendererParams::LocateCaret { generation, .. }
+        | PreviewRendererParams::LocateRange { generation, .. } => {
+            if *generation == 0 {
+                return Err(invalid_params(
+                    "preview renderer generation must be positive",
+                ));
+            }
+        }
+        PreviewRendererParams::Close { .. } => {}
+    }
+    Ok(())
+}
+
+fn validate_digest(name: &str, value: &str) -> Result<(), sync_ls::ResponseError> {
+    if value.len() != 64
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(invalid_params(format!(
+            "preview renderer {name} must be a SHA-256 hex digest"
+        )));
+    }
+    Ok(())
+}
+
+fn renderer_entry_state(
+    entry_path: &str,
+    mount_root: &str,
+) -> Result<EntryState, sync_ls::ResponseError> {
+    let relative = entry_path
+        .strip_prefix(mount_root)
+        .ok_or_else(|| internal_error("preview renderer entry is outside its immutable mount"))?;
+    let main = VirtualPath::new(relative)
+        .map_err(|_| internal_error("preview renderer entry virtual path is invalid"))?;
+    Ok(EntryState::new_rooted(
+        ImmutPath::from(Path::new(mount_root)),
+        Some(main),
+    ))
+}
+
+fn validate_preview_mounts(
+    mounts: Vec<PreviewRendererMount>,
+    entry_path: &str,
+    mount_root: &str,
+    expected_source_digest: &str,
+) -> Result<Vec<RegisteredPreviewMount>, sync_ls::ResponseError> {
+    if mounts.is_empty() || mounts.len() > MAX_PREVIEW_MOUNT_FILES {
+        return Err(invalid_params(
+            "preview renderer mount count exceeds its limit",
+        ));
+    }
+    let mount_prefix = format!("{mount_root}/");
+    let mut validated = Vec::with_capacity(mounts.len());
+    for mount in mounts {
+        validate_digest("mount contentDigest", &mount.content_digest)?;
+        let path = canonical_path(Path::new(&mount.path))?;
+        if !path.starts_with(&mount_prefix) {
+            return Err(invalid_params(
+                "preview renderer file is outside its immutable mount root",
+            ));
+        }
+        validated.push(RegisteredPreviewMount {
+            path: PathBuf::from(path),
+            content_digest: mount.content_digest,
+        });
+    }
+    validated.sort_by(|left, right| left.path.as_os_str().cmp(right.path.as_os_str()));
+    if validated
+        .windows(2)
+        .any(|pair| pair[0].path == pair[1].path)
+    {
+        return Err(invalid_params(
+            "preview renderer mount paths must be unique",
+        ));
+    }
+    if !validated
+        .iter()
+        .any(|mount| mount.path == Path::new(entry_path))
+    {
+        return Err(invalid_params("preview renderer entry file is not mounted"));
+    }
+    let mut fields = Vec::with_capacity(1 + validated.len() * 2);
+    fields.push(entry_path.as_bytes());
+    for mount in &validated {
+        fields.push(
+            mount
+                .path
+                .to_str()
+                .expect("canonical renderer path is valid UTF-8")
+                .as_bytes(),
+        );
+        fields.push(mount.content_digest.as_bytes());
+    }
+    let actual_source_digest = canonical_bytes_digest("mmt-preview-compiler-snapshot-v1", &fields);
+    if actual_source_digest != expected_source_digest {
+        return Err(invalid_params(
+            "preview renderer sourceDigest does not match its immutable mounts",
+        ));
+    }
+    Ok(validated)
+}
+
+fn preview_mount_root(entry_path: &str) -> Result<String, sync_ls::ResponseError> {
+    let mut segments = entry_path.split('/');
+    if segments.next() != Some("") || segments.next() != Some("__mmt_preview") {
+        return Err(internal_error(
+            "preview renderer entry is outside the synthetic mount root",
+        ));
+    }
+    let Some(logical_source_id) = segments.next() else {
+        return Err(internal_error(
+            "preview renderer entry has no logical source mount",
+        ));
+    };
+    if logical_source_id.len() != 64
+        || !logical_source_id
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(internal_error(
+            "preview renderer logical source mount is invalid",
+        ));
+    }
+    Ok(format!("/__mmt_preview/{logical_source_id}"))
+}
+
+fn canonical_path(path: &Path) -> Result<String, sync_ls::ResponseError> {
+    let value = path
+        .to_str()
+        .ok_or_else(|| invalid_params("preview renderer mount path is not UTF-8"))?;
+    if !value.starts_with('/')
+        || value.contains('\\')
+        || value.contains('\0')
+        || value
+            .split('/')
+            .skip(1)
+            .any(|segment| segment.is_empty() || segment == "." || segment == "..")
+    {
+        return Err(invalid_params(
+            "preview renderer mount path is not canonical",
+        ));
+    }
+    Ok(value.to_owned())
+}
+
+fn canonical_bytes_digest(domain: &str, fields: &[&[u8]]) -> String {
+    let mut digest = Sha256::new();
+    digest.update((domain.len() as u64).to_be_bytes());
+    digest.update(domain.as_bytes());
+    for field in fields {
+        digest.update((field.len() as u64).to_be_bytes());
+        digest.update(field);
+    }
+    format!("{:x}", digest.finalize())
+}
+
+fn sha256_hex(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
