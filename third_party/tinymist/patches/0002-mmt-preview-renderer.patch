+    #[test]
+    fn f32_endpoint_cells_hit_both_edges_but_not_adjacent_float_values() {
+        let source = Source::detached("x");
+        let id = source.id();
+        let span = source.root().span();
+        let size = Size::splat(Abs::pt(100.0));
+        let start = 10.000_000_1;
+        let end = 11.000_000_6;
+        let at_start = renderer_point(0, start as f32, 45.0, size);
+        let at_end = renderer_point(0, end as f32, 45.0, size);
+        assert!(size.x.to_pt() * at_start.x < start);
+        assert!(size.x.to_pt() * at_end.x > end);
+        let geometry = test_geometry(
+            source,
+            size,
+            vec![cluster(id, span, 0..1, start, end - start, 40.0)],
+        );
+
+        let hit = geometry
+            .hit_test(at_start, uncertainty(0.0, 0.0), PositionEncoding::Utf16)
+            .unwrap();
+        assert_eq!(
+            hit.range,
+            LspRange::new(LspPosition::new(0, 0), LspPosition::new(0, 0))
+        );
+        assert_eq!(hit.affinity, PreviewCaretAffinity::Before);
+        let hit = geometry
+            .hit_test(at_end, uncertainty(0.0, 0.0), PositionEncoding::Utf16)
+            .unwrap();
+        assert_eq!(
+            hit.range,
+            LspRange::new(LspPosition::new(0, 1), LspPosition::new(0, 1))
+        );
+        assert_eq!(hit.affinity, PreviewCaretAffinity::After);
+
+        let previous = f32::from_bits((start as f32).to_bits() - 2);
+        let next = f32::from_bits((end as f32).to_bits() + 2);
+        assert!(geometry
+            .hit_test(
+                renderer_point(0, previous, 45.0, size),
+                uncertainty(0.0, 0.0),
+                PositionEncoding::Utf16
+            )
+            .is_none());
+        assert!(geometry
+            .hit_test(
+                renderer_point(0, next, 45.0, size),
+                uncertainty(0.0, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .is_none());
+    }
