+const PROTOCOL_VERSION: &str = "mmt-preview-renderer-v1";
+const DIFF_V1_PREFIX: &[u8] = b"diff-v1,";
+const NEW_PREFIX: &[u8] = b"new,";
+const MAX_PREVIEW_RENDER_SESSIONS: usize = 8;
+
+const MAX_PREVIEW_MOUNT_FILES: usize = 1024;
+const MAX_PREVIEW_FONT_FILES: usize = 64;
