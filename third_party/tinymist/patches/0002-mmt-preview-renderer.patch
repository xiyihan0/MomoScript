+    },
+    #[serde(rename = "missingFiles")]
+    MissingFiles {
+        protocol_version: &'static str,
+        session_id: String,
+        source_digest: String,
+        content_digests: Vec<String>,
+    },
+    #[serde(rename = "ready")]
+    Ready {
+        protocol_version: &'static str,
+        session_id: String,
