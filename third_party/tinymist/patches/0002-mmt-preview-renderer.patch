+struct StagedPreviewRendererGeneration {
+    state: PreviewRendererGeneration,
+    base_generation: u64,
+    frame_kind: &'static str,
+    data_base64: String,
+    byte_length: usize,
+}
+
+impl StagedPreviewRendererGeneration {
+    fn response(&self, session_id: String) -> PreviewRendererResponse {
+        PreviewRendererResponse::Ready {
+            protocol_version: PROTOCOL_VERSION,
+            session_id,
+            snapshot_token: self.state.snapshot_token.clone(),
+            source_digest: self.state.source_digest.clone(),
+            artifact_digest: self.state.artifact_digest.clone(),
+            compiler_revision: self.state.compiler_revision,
+            generation: self.state.generation,
+            base_generation: self.base_generation,
+            frame_kind: self.frame_kind,
+            data_base64: self.data_base64.clone(),
+            byte_length: self.byte_length,
+            page_count: self.state.page_count,
+        }
+    }
+}
+
+impl PreviewRendererSession {
+    fn new(last_used: u64) -> Self {
+        Self {
+            registered: None,
+            live_world: None,
+            base_font_resolver: None,
+            mount_digests: HashMap::new(),
+            mount_byte_lengths: HashMap::new(),
+            font_digests: Vec::new(),
+            committed_renderer: None,
+            staged_renderer: None,
+            committed: None,
+            staged: None,
+            last_used,
+        }
+    }
+
+    fn expected_base_generation(&self) -> Option<u64> {
+        self.committed
+            .as_ref()
+            .map(|generation| generation.generation)
+    }
+}
+
+impl Default for PreviewRendererState {
+    fn default() -> Self {
+        Self {
+            sessions: HashMap::new(),
+            file_records: HashMap::new(),
+            file_record_bytes: 0,
+            clock: 0,
+        }
+    }
+}
+
+impl PreviewRendererState {
+    fn touch(&mut self) -> u64 {
+        self.clock = self.clock.checked_add(1).unwrap_or(1);
+        self.clock
+    }
+
+    fn ensure_capacity_for(&mut self, session_id: &str) {
+        if self.sessions.contains_key(session_id)
+            || self.sessions.len() < MAX_PREVIEW_RENDER_SESSIONS
+        {
+            return;
+        }
+        if let Some(oldest) = self
+            .sessions
+            .iter()
+            .min_by_key(|(_, session)| session.last_used)
+            .map(|(id, _)| id.clone())
+        {
+            self.sessions.remove(&oldest);
+        }
+    }
+
+    fn ensure_file_capacity(&mut self, added_bytes: usize) -> Result<(), sync_ls::ResponseError> {
+        if added_bytes > MAX_PREVIEW_FILE_CACHE_BYTES {
+            return Err(invalid_params(
+                "preview renderer file cache item exceeds its byte limit",
+            ));
+        }
+        while self.file_records.len() >= MAX_PREVIEW_FILE_CACHE_RECORDS
+            || self.file_record_bytes.saturating_add(added_bytes) > MAX_PREVIEW_FILE_CACHE_BYTES
+        {
+            let Some(candidate) = self
+                .file_records
+                .iter()
+                .min_by_key(|(_, record)| record.last_used)
+                .map(|(digest, _)| digest.clone())
+            else {
+                return Err(invalid_params(
+                    "preview renderer immutable file cache is exhausted",
+                ));
+            };
+            if let Some(record) = self.file_records.remove(&candidate) {
+                self.file_record_bytes = self.file_record_bytes.saturating_sub(record.byte_length);
+            }
+        }
+        Ok(())
+    }
+
+    fn cache_file_record(
+        &mut self,
+        content_digest: String,
+        bytes: Vec<u8>,
+    ) -> Result<(), sync_ls::ResponseError> {
+        let last_used = self.touch();
+        if let Some(record) = self.file_records.get_mut(&content_digest) {
+            record.last_used = last_used;
+            return Ok(());
+        }
+        self.ensure_file_capacity(bytes.len())?;
+        let byte_length = bytes.len();
+        self.file_records.insert(
+            content_digest,
+            CachedPreviewFile {
+                bytes: Bytes::new(bytes),
+                byte_length,
+                last_used,
+            },
+        );
+        self.file_record_bytes += byte_length;
+        Ok(())
+    }
+}
