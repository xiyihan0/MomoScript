+//! Host-facing incremental preview vector data plane.
+//!
+//! This deliberately exposes only the stateful vector producer already used by
+//! Tinymist preview. Transport, DOM ownership, navigation, and export remain
+//! host responsibilities.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
