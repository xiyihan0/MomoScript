+    #[test]
+    fn escaped_unicode_source_boundaries_are_exact_and_grapheme_safe() {
+        let source = Source::detached(r#"#text("A😀é中\n\"\\\u{1f600}")"#);
+        let origin = literal_origin(&source);
+        assert_eq!(origin.text, "A😀é中\n\"\\😀");
+        assert_eq!(origin.source_offset(0), Some(7));
+        assert_eq!(origin.source_offset(1), Some(8));
+        assert_eq!(origin.source_offset(5), Some(12));
+        assert!(origin.source_offset(2).is_none());
+        assert!(!origin.is_grapheme(6));
+        assert!(origin.is_grapheme(8));
+        for &(decoded, raw) in &origin.boundaries {
+            assert!(origin.text.is_char_boundary(decoded));
+            assert!(source.text().is_char_boundary(raw));
+            for encoding in [PositionEncoding::Utf8, PositionEncoding::Utf16] {
+                let position = offset_to_position(&source, encoding, raw).unwrap();
+                assert_eq!(position_to_offset(&source, encoding, position), Some(raw));
+            }
+        }
+        assert_eq!(
+            origin.source_offset(origin.text.len()),
+            Some(source.text().len() - 2)
+        );
+    }
