+                entry_uri,
+                render_entry_uri,
+                source_digest,
+                mounts,
+                font_digests,
+                files,
+            ),
+            PreviewRendererParams::Render {
+                session_id,
+                snapshot_token,
+                source_digest,
+                base_generation,
+                force_full,
+                ..
+            } => self.preview_renderer_render(
+                session_id,
+                snapshot_token,
+                source_digest,
+                base_generation,
