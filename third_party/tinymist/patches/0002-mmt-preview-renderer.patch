+    #[test]
+    fn measured_uncertainty_recovers_minimum_zoom_boundary_but_stays_fail_closed() {
+        let source = Source::detached("mmmm");
+        let id = source.id();
+        let span = source.root().span();
+        let size = Size::new(Abs::pt(595.28), Abs::pt(841.89));
+        let page_width = renderer_page_extent(size.x).unwrap();
+        let page_height = renderer_page_extent(size.y).unwrap();
+        assert_eq!(page_width, 596.0);
+        assert_eq!(page_height, 842.0);
+
+        // Captured at 10% zoom: Float32 screen coordinates invert to just
+        // outside the native 133.54pt start edge.
+        let observed_x = 133.539_715_296_495_61;
+        let native_x = 133.54;
+        let observed_y = 58.799_991_576_819_366;
+        let point = |x| PreviewPoint {
+            page_index: 0,
+            x: x / page_width,
+            y: observed_y / page_height,
+        };
+        let target = || cluster(id, span, 0..4, native_x, 32.92, 50.0);
+        let geometry = test_geometry(source.clone(), size, vec![target()]);
+
+        assert!(geometry
+            .hit_test(
+                point(observed_x),
+                uncertainty(0.0, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .is_none());
+        assert!(geometry
+            .hit_test(
+                point(observed_x),
+                uncertainty(0.0001 / page_width, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .is_none());
+        let hit = geometry
+            .hit_test(
+                point(observed_x),
+                uncertainty(0.0003 / page_width, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .unwrap();
+        assert_eq!(
+            hit.range,
+            LspRange::new(LspPosition::new(0, 0), LspPosition::new(0, 0))
