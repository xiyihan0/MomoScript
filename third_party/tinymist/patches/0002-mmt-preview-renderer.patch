+                stops: vec![
+                    CaretStop {
+                        offset: range.start,
+                        edge: left,
+                        affinity: Some(PreviewCaretAffinity::Before),
+                    },
+                    CaretStop {
+                        offset: range.end,
+                        edge: right,
+                        affinity: Some(PreviewCaretAffinity::After),
+                    },
+                ],
+            }),
+            marker_band: None,
+        }
+    }
+    fn test_geometry(
+        source: Source,
+        size: Size,
+        clusters: Vec<TextCluster>,
+    ) -> PreviewTextGeometry {
+        let id = source.id();
+        PreviewTextGeometry {
+            sources: HashMap::from([(
+                id,
+                GeometrySource {
+                    source,
+                    uri: Url::parse("file:///main.typ").unwrap(),
+                },
+            )]),
+            pages: vec![GeometryPage { size, clusters }],
+        }
+    }
+
+    fn renderer_point(page_index: usize, x: f32, y: f32, size: Size) -> PreviewPoint {
+        PreviewPoint {
+            page_index,
+            x: f64::from(x) / renderer_page_extent(size.x).unwrap(),
+            y: f64::from(y) / renderer_page_extent(size.y).unwrap(),
+        }
+    }
+
+    fn uncertainty(x: f64, y: f64) -> PreviewRendererPointUncertainty {
+        PreviewRendererPointUncertainty { x, y }
+    }
+
+    #[test]
+    fn fractional_page_extents_round_trip_rendered_points_and_boxes() {
+        let source = Source::detached("a");
+        let id = source.id();
+        let span = source.root().span();
+        let size = Size::new(Abs::pt(100.1), Abs::pt(80.25));
+        let geometry = test_geometry(
+            source,
+            size,
+            vec![cluster(id, span, 0..1, 10.25, 20.5, 60.5)],
+        );
+        let caret = geometry
+            .caret_at(id, 1, PreviewCaretAffinity::After)
+            .pop()
+            .unwrap();
+        assert!((caret.rect.x * 101.0 - 30.75).abs() < 1e-10);
+        assert!((caret.rect.y * 81.0 - 60.5).abs() < 1e-10);
+        let range = geometry.range_at(id, 0..1).pop().unwrap();
+        assert!((range.x * 101.0 - 10.25).abs() < 1e-10);
+        assert!((range.width * 101.0 - 20.5).abs() < 1e-10);
+        assert!((range.y * 81.0 - 60.5).abs() < 1e-10);
+        let hit = geometry
+            .hit_test(
+                PreviewPoint {
+                    page_index: 0,
+                    x: 10.25 / 101.0,
+                    y: 65.5 / 81.0,
+                },
+                uncertainty(0.0, 0.0),
+                PositionEncoding::Utf16,
+            )
+            .unwrap();
+        assert_eq!(hit.range.start, LspPosition::new(0, 0));
+    }
+
+    fn transform_cluster(cluster: &mut TextCluster, transform: Transform) {
+        for point in cluster
+            .left
+            .iter_mut()
+            .chain(cluster.right.iter_mut())
+            .chain(cluster.baseline.iter_mut())
+            .chain(cluster.rendered_left.iter_mut())
+            .chain(cluster.rendered_right.iter_mut())
+            .chain(cluster.rendered_seams.iter_mut().flatten())
+            .chain(
+                cluster
+                    .mapped
+                    .as_mut()
+                    .unwrap()
+                    .stops
+                    .iter_mut()
+                    .flat_map(|stop| stop.edge.iter_mut()),
+            )
+        {
+            *point = point.transform(transform);
+        }
+    }
