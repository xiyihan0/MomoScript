+impl GeometryBuilder<'_> {
+    fn frame(
+        &mut self,
+        frame: &Frame,
+        transform: Transform,
+        renderer_transform: RendererTransform,
+        body: Option<BodyBounds>,
+        clusters: &mut Vec<TextCluster>,
+    ) {
+        if let Some(marker) = self.empty_line_marker(frame, transform, body) {
+            clusters.push(marker);
+        }
+        for (position, item) in frame.items() {
+            let transform = transform.pre_concat(Transform::translate(position.x, position.y));
+            let renderer_transform =
+                renderer_transform.pre_concat(RendererTransform::translation(*position));
+            match item {
+                FrameItem::Group(group) => {
+                    let transform = transform.pre_concat(group.transform);
+                    let renderer_transform =
+                        renderer_transform.pre_concat(RendererTransform::matrix(group.transform));
+                    let body = group
+                        .label
+                        .filter(|label| {
+                            let label = label.resolve();
+                            label.starts_with("mmt:bubble:") || label.starts_with("mmt:narration:")
+                        })
+                        .and_then(|_| {
+                            transform.invert().map(|inverse| BodyBounds {
+                                inverse,
+                                size: group.frame.size(),
+                            })
+                        })
+                        .or(body);
+                    if let Some(clip) = &group.clip {
+                        let mut inner = Vec::new();
+                        self.frame(
+                            &group.frame,
+                            transform,
+                            renderer_transform,
+                            body,
+                            &mut inner,
+                        );
+                        for cluster in &mut inner {
+                            // Rectangular clips can prove full visibility. An
+                            // arbitrary or partial clip is an obstruction, not
+                            // permission to hit invisible text underneath.
+                            if !inside_rectangular_clip(cluster, clip, renderer_transform) {
+                                cluster.mapped = None;
+                                cluster.marker_band = None;
+                            }
+                        }
+                        clusters.extend(inner);
+                    } else {
+                        self.frame(&group.frame, transform, renderer_transform, body, clusters);
+                    }
+                }
+                FrameItem::Text(text) => self.text(text, transform, renderer_transform, clusters),
+                _ => {}
+            }
+        }
+    }
+
+    fn empty_line_marker(
+        &mut self,
+        frame: &Frame,
+        transform: Transform,
+        body: Option<BodyBounds>,
+    ) -> Option<TextCluster> {
+        if !frame.kind().is_hard() || frame.width() != Abs::zero() || frame.height() <= Abs::zero()
+        {
+            return None;
+        }
+        let mut marker = None;
+        for (_, item) in frame.items() {
+            let FrameItem::Tag(Tag::Start(content, _)) = item else {
+                continue;
+            };
+            let Some(metadata) = content.to_packed::<MetadataElem>() else {
+                continue;
+            };
+            let Value::Dict(value) = &metadata.value else {
+                continue;
+            };
+            let Ok(offset) = value.get("mmtTextCaret") else {
+                continue;
+            };
+            if value.len() != 1 || marker.is_some() {
+                return None;
+            }
+            let Value::Int(offset) = offset else {
+                return None;
+            };
+            let offset = usize::try_from(*offset).ok()?;
+            let id = content.span().id()?;
+            let source = &self.load_source(id)?.source;
+            let span = empty_marker_span(source, content.span(), offset)?;
+            marker = Some((id, span, offset));
+        }
+        let (id, span, offset) = marker?;
+        let edge = [
+            Point::zero().transform(transform),
+            Point::new(Abs::zero(), frame.height()).transform(transform),
+        ];
+        let baseline = Point::new(Abs::zero(), frame.baseline()).transform(transform);
+        Some(TextCluster {
+            left: edge,
+            right: edge,
+            baseline: [baseline, baseline],
+            rendered_left: edge,
+            rendered_right: edge,
+            rendered_seams: Vec::new(),
+            mapped: Some(MappedCluster {
+                id,
+                span,
+                source: offset..offset,
+                marker: true,
+                starts_grapheme: true,
+                ends_grapheme: true,
+                stops: vec![CaretStop {
+                    offset,
+                    edge,
+                    affinity: None,
+                }],
+            }),
+            marker_band: body.and_then(|body| {
+                transform.invert().map(|inverse| MarkerBand {
+                    body,
+                    inverse,
+                    height: frame.height(),
+                })
+            }),
+        })
+    }
+
+    fn text(
+        &mut self,
+        text: &TextItem,
+        transform: Transform,
+        renderer_transform: RendererTransform,
+        clusters: &mut Vec<TextCluster>,
+    ) {
+        let top = -text.font.metrics().ascender.at(text.size);
+        let bottom = -text.font.metrics().descender.at(text.size);
+        let mut cursor = Point::zero();
+        let mut renderer_cursor = (0.0f32, 0.0f32);
+        let mut index = 0;
+        let descending = text.glyphs.windows(2).find_map(|pair| {
+            (pair[0].range.start != pair[1].range.start)
+                .then_some(pair[0].range.start > pair[1].range.start)
+        });
+        while let Some(glyph) = text.glyphs.get(index) {
+            let start = cursor;
+            let renderer_start = renderer_cursor;
+            let first = index;
+            while let Some(next) = text.glyphs.get(index) {
+                if next.range != glyph.range || next.span != glyph.span {
+                    break;
+                }
+                let x_advance = next.x_advance.at(text.size);
+                let y_advance = next.y_advance.at(text.size);
+                cursor.x += x_advance;
+                cursor.y -= y_advance;
+                renderer_cursor.0 += x_advance.to_pt() as f32;
+                renderer_cursor.1 -= y_advance.to_pt() as f32;
+                index += 1;
+            }
+            let edge = |at: Point| {
+                [
+                    Point::new(at.x, at.y + top).transform(transform),
+                    Point::new(at.x, at.y + bottom).transform(transform),
+                ]
+            };
+            let left = edge(start);
+            let right = edge(cursor);
+            let baseline = [start.transform(transform), cursor.transform(transform)];
+            let mut renderer_end_x = f64::from(renderer_cursor.0);
+            if index == text.glyphs.len() {
+                renderer_end_x = svg_text_width(text).unwrap_or(f64::NAN);
+            }
+            let (renderer_top, renderer_bottom) =
+                svg_text_vertical_bounds(text).unwrap_or((f64::NAN, f64::NAN));
+            let rendered_left = [
+                renderer_transform.point(
+                    f64::from(renderer_start.0),
+                    f64::from(renderer_start.1) + renderer_top,
+                ),
+                renderer_transform.point(
+                    f64::from(renderer_start.0),
+                    f64::from(renderer_start.1) + renderer_bottom,
+                ),
+            ];
+            let rendered_right = [
+                renderer_transform
+                    .point(renderer_end_x, f64::from(renderer_cursor.1) + renderer_top),
+                renderer_transform.point(
+                    renderer_end_x,
+                    f64::from(renderer_cursor.1) + renderer_bottom,
+                ),
+            ];
+            let mapped = self.origin(glyph.span.0).and_then(|origin| {
+                let value = text.text.get(glyph.range())?;
+                let from = usize::from(glyph.span.1);
+                let to = from.checked_add(value.len())?;
+                // span offsets and item ranges are u16 in Typst. Saturated or
+                // wrapped values cannot authorize an edit, even if text repeats.
+                if glyph.span.1 == u16::MAX
+                    || glyph.range.end == u16::MAX
+                    || origin.text.len() > usize::from(u16::MAX)
+                    || origin.text.get(from..to)? != value
+                    || value.is_empty()
+                {
+                    return None;
+                }
+                // A singleton RTL run has no ordering evidence in TextItem.
+                // Never invent its logical direction from an advance width.
+                let rtl = descending.unwrap_or(false);
+                if descending.is_none() && value.chars().any(is_rtl_or_bidi_control) {
+                    return None;
+                }
+                let source = origin.source_offset(from)?..origin.source_offset(to)?;
+                let starts_grapheme = origin.is_grapheme(from);
+                let ends_grapheme = origin.is_grapheme(to);
+                let mut stops = Vec::new();
+                if starts_grapheme {
+                    stops.push(CaretStop {
+                        offset: source.start,
+                        edge: if rtl { right } else { left },
+                        affinity: Some(PreviewCaretAffinity::Before),
+                    });
+                }
+                let interior = origin
+                    .graphemes
+                    .iter()
+                    .copied()
+                    .filter(|&at| from < at && at < to)
+                    .collect::<Vec<_>>();
+                if !interior.is_empty() && index - first == 1 && starts_grapheme && ends_grapheme {
+                    if let Some(mut carets) = ligature_carets(text, glyph, interior.len()) {
+                        if rtl {
+                            carets.reverse();
+                        }
+                        for (decoded, x) in interior.into_iter().zip(carets) {
+                            let at = Point::new(
+                                start.x + glyph.x_offset.at(text.size) + Abs::pt(x),
+                                start.y,
+                            );
+                            let caret = edge(at);
+                            // Broken font data is not an excuse to leave the
+                            // actual compiled cluster's advance interval.
+                            let advance = (cursor.x - start.x).to_pt();
+                            let advance_x = (at.x - start.x).to_pt();
+                            if !(0.0..=advance).contains(&advance_x) {
+                                return None;
+                            }
+                            stops.push(CaretStop {
+                                offset: origin.source_offset(decoded)?,
+                                edge: caret,
+                                affinity: None,
+                            });
+                        }
+                    }
+                }
+                if ends_grapheme {
+                    stops.push(CaretStop {
+                        offset: source.end,
+                        edge: if rtl { left } else { right },
+                        affinity: Some(PreviewCaretAffinity::After),
+                    });
+                }
+                Some(MappedCluster {
+                    id: origin.id,
+                    span: glyph.span.0,
+                    source,
+                    marker: false,
+                    starts_grapheme,
+                    ends_grapheme,
+                    stops,
+                })
+            });
+            let cluster = TextCluster {
+                left,
+                right,
+                baseline,
+                rendered_left,
+                rendered_right,
+                rendered_seams: Vec::new(),
+                mapped,
+                marker_band: None,
+            };
+            if let Some(previous) = clusters.last_mut() {
+                if previous.join_grapheme(&cluster) {
+                    continue;
+                }
+            }
+            clusters.push(cluster);
+        }
+    }
+
+    fn origin(&mut self, span: Span) -> Option<&TextOrigin> {
+        if !self.origins.contains_key(&span) {
+            let origin = span
+                .id()
+                .and_then(|id| TextOrigin::from_source(&self.load_source(id)?.source, span));
+            self.origins.insert(span, origin);
+        }
+        self.origins.get(&span)?.as_ref()
+    }
+
+    fn load_source(&mut self, id: FileId) -> Option<&GeometrySource> {
+        if !self.sources.contains_key(&id) {
+            let source = self.world.source(id).ok()?;
+            let uri = if self.world.id_for_path(as_path_(self.entry_uri).as_path()) == Some(id) {
+                self.entry_uri.clone()
+            } else {
+                path_res_to_url(self.world.path_for_id(id).ok()?).ok()?
+            };
+            self.sources.insert(id, GeometrySource { source, uri });
+        }
+        self.sources.get(&id)
+    }
+}
+
+impl TextOrigin {
+    fn from_source(source: &Source, span: Span) -> Option<Self> {
+        let node = source.find(span)?;
+        // text("literal") attaches the call's span after converting its string
+        // argument into Content. Resolve only this structurally exact form, not
+        // the first string found somewhere below an arbitrary macro call.
+        let literal_span = if let Some(call) = node.cast::<ast::FuncCall>() {
+            let ast::Expr::Ident(callee) = call.callee() else {
+                return None;
+            };
+            if callee.as_str() != "text" {
+                return None;
+            }
+            let mut args = call.args().items();
+            let ast::Arg::Pos(ast::Expr::Str(literal)) = args.next()? else {
+                return None;
+            };
+            if args.next().is_some() {
+                return None;
+            }
+            Some(literal.span())
+        } else {
+            None
+        };
+        let node = if let Some(literal_span) = literal_span {
+            source.find(literal_span)?
+        } else {
+            node
+        };
+        let range = node.range();
+        let raw = source.text().get(range.clone())?;
+        let (text, boundaries) = match node.kind() {
+            SyntaxKind::Str => decode_string(raw, range.start)?,
+            SyntaxKind::Text | SyntaxKind::Space | SyntaxKind::MathText => {
+                let boundaries = raw
+                    .char_indices()
+                    .map(|(i, _)| (i, range.start + i))
+                    .chain(std::iter::once((raw.len(), range.end)))
+                    .collect();
+                (raw.to_owned(), boundaries)
+            }
+            SyntaxKind::Escape => {
+                let value = node.cast::<ast::Escape>()?.get().to_string();
+                let len = value.len();
+                (value, vec![(0, range.start), (len, range.end)])
+            }
+            _ => return None,
+        };
+        let mut graphemes = vec![0];
+        // Reuse Typst's own Unicode segmentation instead of maintaining another
+        // Unicode table or accepting scalar boundaries inside a grapheme.
+        let mut offset = 0;
+        for cluster in Str::from(text.as_str()).clusters().iter() {
+            let typst::foundations::Value::Str(cluster) = cluster else {
+                return None;
+            };
+            offset += cluster.len();
+            graphemes.push(offset);
+        }
+        Some(Self {
+            id: source.id(),
+            text,
+            boundaries,
+            graphemes,
+        })
+    }
+
+    fn source_offset(&self, offset: usize) -> Option<usize> {
+        let index = self
+            .boundaries
+            .binary_search_by_key(&offset, |&(decoded, _)| decoded)
+            .ok()?;
+        Some(self.boundaries[index].1)
+    }
+
+    fn is_grapheme(&self, offset: usize) -> bool {
+        self.graphemes.binary_search(&offset).is_ok()
+    }
+}
+
+/// Parse only Typst's reversible string escapes. Unknown/malformed escapes are
+/// rejected, rather than guessed or sliced at a non-UTF-8 boundary.
+fn decode_string(raw: &str, base: usize) -> Option<(String, Vec<(usize, usize)>)> {
+    let inner = raw.strip_prefix('"')?.strip_suffix('"')?;
+    let mut text = String::with_capacity(inner.len());
+    let mut boundaries = vec![(0, base + 1)];
+    let mut offset = 0;
+    while offset < inner.len() {
+        let ch = inner.get(offset..)?.chars().next()?;
+        offset += ch.len_utf8();
+        let value = if ch == '\\' {
+            let escaped = inner.get(offset..)?.chars().next()?;
+            offset += escaped.len_utf8();
+            match escaped {
+                '\\' => '\\',
+                '"' => '"',
+                'n' => '\n',
+                'r' => '\r',
+                't' => '\t',
+                'u' => {
+                    if inner.as_bytes().get(offset) != Some(&b'{') {
+                        return None;
+                    }
+                    offset += 1;
+                    let start = offset;
+                    while inner
+                        .as_bytes()
+                        .get(offset)
+                        .is_some_and(u8::is_ascii_hexdigit)
+                    {
+                        offset += 1;
+                    }
+                    if start == offset || inner.as_bytes().get(offset) != Some(&b'}') {
+                        return None;
+                    }
+                    let value =
+                        char::from_u32(u32::from_str_radix(inner.get(start..offset)?, 16).ok()?)?;
+                    offset += 1;
+                    value
+                }
+                _ => return None,
+            }
+        } else {
+            ch
+        };
+        text.push(value);
+        boundaries.push((text.len(), base + 1 + offset));
+    }
+    Some((text, boundaries))
+}
