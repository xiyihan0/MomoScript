+#[derive(Clone, Copy)]
+struct RendererTransform {
+    sx: f64,
+    ky: f64,
+    kx: f64,
+    sy: f64,
+    tx: f64,
+    ty: f64,
+}
+
+impl RendererTransform {
+    fn page(size: Size) -> Option<Self> {
+        renderer_page_extent(size.x)?;
+        renderer_page_extent(size.y)?;
+        // Frame edges and serialized SVG transforms share page-point units.
+        // Integral page extents belong only to the normalized wire boundary.
+        Some(Self {
+            sx: 1.0,
+            ky: 0.0,
+            kx: 0.0,
+            sy: 1.0,
+            tx: 0.0,
+            ty: 0.0,
+        })
+    }
+
+    fn translation(point: Point) -> Self {
+        Self {
+            sx: 1.0,
+            ky: 0.0,
+            kx: 0.0,
+            sy: 1.0,
+            tx: svg_fixed_3(point.x.to_pt() as f32).unwrap_or(f64::NAN),
+            ty: svg_fixed_3(point.y.to_pt() as f32).unwrap_or(f64::NAN),
+        }
+    }
+
+    fn matrix(transform: Transform) -> Self {
+        let number = |value: f32| svg_shortest(value).unwrap_or(f64::NAN);
+        Self {
+            sx: number(transform.sx.get() as f32),
+            ky: number(transform.ky.get() as f32),
+            kx: number(transform.kx.get() as f32),
+            sy: number(transform.sy.get() as f32),
+            tx: number(transform.tx.to_pt() as f32),
+            ty: number(transform.ty.to_pt() as f32),
+        }
+    }
+
+    fn pre_concat(self, previous: Self) -> Self {
+        Self {
+            sx: self.sx * previous.sx + self.kx * previous.ky,
+            ky: self.ky * previous.sx + self.sy * previous.ky,
+            kx: self.sx * previous.kx + self.kx * previous.sy,
+            sy: self.ky * previous.kx + self.sy * previous.sy,
+            tx: self.sx * previous.tx + self.kx * previous.ty + self.tx,
+            ty: self.ky * previous.tx + self.sy * previous.ty + self.ty,
+        }
+    }
+
+    fn point(self, x: f64, y: f64) -> Point {
+        Point::new(
+            Abs::pt(self.sx * x + self.kx * y + self.tx),
+            Abs::pt(self.ky * x + self.sy * y + self.ty),
+        )
+    }
+}
+
+impl ScalarInterval {
+    fn shifted(self, value: f64) -> Self {
+        Self {
+            lo: self.lo + value,
+            hi: self.hi + value,
+        }
+    }
+
+    fn expanded(self, radius: f64) -> Option<Self> {
+        if !radius.is_finite() || radius < 0.0 {
+            return None;
+        }
+        let expanded = Self {
+            lo: self.lo - radius,
+            hi: self.hi + radius,
+        };
+        expanded.is_finite().then_some(expanded)
+    }
+
+    fn scaled(self, value: f64) -> Self {
+        let a = self.lo * value;
+        let b = self.hi * value;
+        Self {
+            lo: a.min(b),
+            hi: a.max(b),
+        }
+    }
+
+    fn add(self, other: Self) -> Self {
+        Self {
+            lo: self.lo + other.lo,
+            hi: self.hi + other.hi,
+        }
+    }
+
+    fn is_finite(self) -> bool {
+        self.lo.is_finite() && self.hi.is_finite() && self.lo <= self.hi
+    }
+
+    fn overlaps(self, lo: f64, hi: f64) -> bool {
+        self.hi >= lo && self.lo <= hi
+    }
+}
+
+impl HitTestPoint {
+    fn new(
+        position: PreviewPoint,
+        uncertainty: PreviewRendererPointUncertainty,
+        size: Size,
+        rendered_y_offset: f64,
+    ) -> Option<Self> {
+        let rendered_width = renderer_page_extent(size.x)?;
+        let rendered_height = renderer_page_extent(size.y)?;
+        let rendered_x = position.x * rendered_width;
+        let rendered_y = rendered_y_offset + position.y * rendered_height;
+        let uncertainty_x = uncertainty.x * rendered_width;
+        let uncertainty_y = uncertainty.y * rendered_height;
+        Some(Self {
+            point: Point::new(Abs::pt(rendered_x), Abs::pt(position.y * rendered_height)),
+            x: f32_precision_interval(rendered_x)?.expanded(uncertainty_x)?,
+            y: f32_precision_interval(rendered_y)?
+                .shifted(-rendered_y_offset)
+                .expanded(uncertainty_y)?,
+        })
+    }
+}
+
+fn renderer_page_extent(value: Abs) -> Option<f64> {
+    let value = value.to_pt() as f32;
+    if !value.is_finite() || value <= 0.0 {
+        return None;
+    }
+    Some(f64::from(value.ceil().round().max(1.0) as u32))
+}
+
+/// Retain the residual adjacent-f32 cell from normalized wire coordinates.
+/// Screen sampling and inverse-transform uncertainty is supplied separately and
+/// expands containment only.
+fn f32_precision_interval(value: f64) -> Option<ScalarInterval> {
+    let rounded = value as f32;
+    if !rounded.is_finite() {
+        return None;
+    }
+    let previous = rounded.next_down();
+    let next = rounded.next_up();
+    if !previous.is_finite() || !next.is_finite() {
+        return None;
+    }
+    let lo = value - (f64::from(rounded) - f64::from(previous));
+    let hi = value + (f64::from(next) - f64::from(rounded));
+    Some(ScalarInterval { lo, hi })
+}
+
+fn svg_shortest(value: f32) -> Option<f64> {
+    if !value.is_finite() {
+        return None;
+    }
+    let mut output = FloatBuffer::new();
+    write!(&mut output, "{value}").ok()?;
+    output.parse()
+}
+
+fn svg_fixed_3(value: f32) -> Option<f64> {
+    if !value.is_finite() {
+        return None;
+    }
+    let mut output = FloatBuffer::new();
+    write!(&mut output, "{value:.3}").ok()?;
+    output.parse()
+}
+
+fn svg_fixed_2(value: f32) -> Option<f64> {
+    if !value.is_finite() {
+        return None;
+    }
+    let mut output = FloatBuffer::new();
+    write!(&mut output, "{value:.2}").ok()?;
+    output.parse()
+}
+
+fn svg_text_width(text: &TextItem) -> Option<f64> {
+    let size = text.size.to_pt() as f32;
+    let upem = text.font.units_per_em() as f32;
+    if !size.is_finite() || !upem.is_finite() || size <= 0.0 || upem <= 0.0 {
+        return None;
+    }
+    let mut width = 0.0f32;
+    for glyph in &text.glyphs {
+        width += glyph.x_advance.at(text.size).to_pt() as f32;
+    }
+    let ppem = size / upem;
+    let metric = width * upem / size / SVG_TEXT_METRIC_SCALE as f32;
+    Some(svg_fixed_2(metric)? * SVG_TEXT_METRIC_SCALE * svg_shortest(ppem)?)
+}
+
+fn svg_text_vertical_bounds(text: &TextItem) -> Option<(f64, f64)> {
+    let size = text.size.to_pt() as f32;
+    let upem = text.font.units_per_em() as f32;
+    if !size.is_finite() || !upem.is_finite() || size <= 0.0 || upem <= 0.0 {
+        return None;
+    }
+    let ascender = text.font.metrics().ascender.get() as f32 * upem;
+    let ppem = svg_shortest(size / upem)?;
+    let top = -svg_fixed_2(ascender / SVG_TEXT_METRIC_SCALE as f32)? * SVG_TEXT_METRIC_SCALE * ppem;
+    let bottom = (-svg_fixed_2(ascender / SVG_TEXT_METRIC_SCALE as f32)?
+        + svg_fixed_2(upem / SVG_TEXT_METRIC_SCALE as f32)?)
+        * SVG_TEXT_METRIC_SCALE
+        * ppem;
+    Some((top.min(bottom), top.max(bottom)))
+}
+fn affine_intervals(
+    px: ScalarInterval,
+    py: ScalarInterval,
+    origin: Point,
+    x: Point,
+    y: Point,
+    determinant: f64,
+) -> (ScalarInterval, ScalarInterval) {
+    let px = px.shifted(-origin.x.to_pt());
+    let py = py.shifted(-origin.y.to_pt());
+    let u = px
+        .scaled(y.y.to_pt())
+        .add(py.scaled(-y.x.to_pt()))
+        .scaled(1.0 / determinant);
+    let v = py
+        .scaled(x.x.to_pt())
+        .add(px.scaled(-x.y.to_pt()))
+        .scaled(1.0 / determinant);
+    (u, v)
+}
+
+fn affine_point(point: Point, origin: Point, x: Point, y: Point, determinant: f64) -> (f64, f64) {
+    let point = point - origin;
+    (
+        (point.x.to_pt() * y.y.to_pt() - point.y.to_pt() * y.x.to_pt()) / determinant,
+        (x.x.to_pt() * point.y.to_pt() - x.y.to_pt() * point.x.to_pt()) / determinant,
+    )
+}
+
+impl TextCluster {
+    fn contains(&self, hit: &HitTestPoint) -> bool {
+        if let Some(band) = &self.marker_band {
+            for x in [hit.x.lo, hit.point.x.to_pt(), hit.x.hi] {
+                for y in [hit.y.lo, hit.point.y.to_pt(), hit.y.hi] {
+                    let point = Point::new(Abs::pt(x), Abs::pt(y));
+                    let body_point = point.transform(band.body.inverse);
+                    let line_point = point.transform(band.inverse);
+                    if (Abs::zero()..=band.body.size.x).contains(&body_point.x)
+                        && (Abs::zero()..=band.body.size.y).contains(&body_point.y)
+                        && (Abs::zero()..=band.height).contains(&line_point.y)
+                    {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+        let x = self.baseline[1] - self.baseline[0];
+        let y = self.left[1] - self.left[0];
+        let determinant = x.x.to_pt() * y.y.to_pt() - x.y.to_pt() * y.x.to_pt();
+        if determinant.abs() < 1e-10 || !hit.x.is_finite() || !hit.y.is_finite() {
+            return false;
+        }
+        let (hit_u, hit_v) = affine_intervals(hit.x, hit.y, self.left[0], x, y, determinant);
+        let mut min_u: f64 = 0.0;
+        let mut max_u: f64 = 1.0;
+        let mut min_v: f64 = 0.0;
+        let mut max_v: f64 = 1.0;
+        for point in self
+            .rendered_left
+            .iter()
+            .chain(&self.rendered_right)
+            .chain(self.rendered_seams.iter().flatten())
+        {
+            let (u, v) = affine_point(*point, self.left[0], x, y, determinant);
+            if !u.is_finite() || !v.is_finite() {
+                return false;
+            }
+            min_u = min_u.min(u);
+            max_u = max_u.max(u);
+            min_v = min_v.min(v);
+            max_v = max_v.max(v);
+        }
+        hit_u.overlaps(min_u, max_u) && hit_v.overlaps(min_v, max_v)
+    }
+
+    fn source_edge(&self, end: bool) -> [Point; 2] {
+        if let Some(mapped) = &self.mapped {
+            let offset = if end {
+                mapped.source.end
+            } else {
+                mapped.source.start
+            };
+            if let Some(stop) = mapped.stops.iter().find(|stop| stop.offset == offset) {
+                return stop.edge;
+            }
+        }
+        if end {
+            self.right
+        } else {
+            self.left
+        }
+    }
+
+    fn join_grapheme(&mut self, next: &Self) -> bool {
+        let (Some(a), Some(b)) = (&mut self.mapped, &next.mapped) else {
+            return false;
+        };
+        if a.id != b.id
+            || a.span != b.span
+            || a.source.end != b.source.start
+            || a.ends_grapheme
+            || b.starts_grapheme
+            || (self.baseline[1] - next.baseline[0]).hypot().to_pt() > 1e-7
+        {
+            return false;
+        }
+        a.source.end = b.source.end;
+        a.ends_grapheme = b.ends_grapheme;
+        a.stops.extend(b.stops.iter().map(|stop| CaretStop {
+            offset: stop.offset,
+            edge: stop.edge,
+            affinity: stop.affinity,
+        }));
+        self.rendered_seams.push(self.rendered_right);
+        self.rendered_seams.push(next.rendered_left);
+        self.rendered_seams
+            .extend(next.rendered_seams.iter().copied());
+        self.right = next.right;
+        self.rendered_right = next.rendered_right;
+        self.baseline[1] = next.baseline[1];
+        true
+    }
+}
+
+/// A marker may refer only to the empty text literal in its own enclosing box,
+/// not an arbitrary integer-selected source position or a neighbouring body.
+fn empty_marker_span(source: &Source, metadata_span: Span, offset: usize) -> Option<Span> {
+    let leaf = LinkedNode::new(source.root()).leaf_at(offset, Side::After)?;
+    if leaf.kind() != SyntaxKind::Str {
+        return None;
+    }
+    let literal = TextOrigin::from_source(source, leaf.span())?;
+    if !literal.text.is_empty() || literal.source_offset(0)? != offset {
+        return None;
+    }
+    let args = leaf.parent()?;
+    let text_call = args.parent()?;
+    let text = TextOrigin::from_source(source, text_call.span())?;
+    if !text.text.is_empty() || text.source_offset(0)? != offset {
+        return None;
+    }
+    let mut metadata = source.find(metadata_span)?;
+    loop {
+        if let Some(call) = metadata.cast::<ast::FuncCall>() {
+            if matches!(call.callee(), ast::Expr::Ident(name) if name.as_str() == "box") {
+                let range = metadata.range();
+                return (range.start <= text_call.range().start
+                    && text_call.range().end <= range.end)
+                    .then_some(leaf.span());
+            }
+        }
+        metadata = metadata.parent()?.clone();
+    }
+}
+
+fn inside_rectangular_clip(
+    cluster: &TextCluster,
+    clip: &Curve,
+    renderer_transform: RendererTransform,
+) -> bool {
+    let [CurveItem::Move(a), CurveItem::Line(b), CurveItem::Line(c), CurveItem::Line(d), CurveItem::Close] =
+        clip.0.as_slice()
+    else {
+        return false;
+    };
+    if a.y != b.y || b.x != c.x || c.y != d.y || d.x != a.x {
+        return false;
+    }
+    let render = |point: Point| {
+        Some(renderer_transform.point(
+            svg_shortest(point.x.to_pt() as f32)?,
+            svg_shortest(point.y.to_pt() as f32)?,
+        ))
+    };
+    let (Some(a), Some(b), Some(_c), Some(d)) = (render(*a), render(*b), render(*c), render(*d))
+    else {
+        return false;
+    };
+    let x = b - a;
+    let y = d - a;
+    let determinant = x.x.to_pt() * y.y.to_pt() - x.y.to_pt() * y.x.to_pt();
+    if determinant.abs() < 1e-10 {
+        return false;
+    }
+    // Full visibility must be proven in the same serialized coordinate space
+    // as the SVG clip. Any partial/uncertain clip remains an obstruction.
+    cluster
+        .rendered_left
+        .iter()
+        .chain(&cluster.rendered_right)
+        .chain(cluster.rendered_seams.iter().flatten())
+        .all(|point| {
+            let (u, v) = affine_point(*point, a, x, y, determinant);
+            (0.0..=1.0).contains(&u) && (0.0..=1.0).contains(&v)
+        })
+}
+
+fn distance_to_edge(point: Point, edge: [Point; 2]) -> f64 {
+    let direction = edge[1] - edge[0];
+    let relative = point - edge[0];
+    let dx = direction.x.to_pt();
+    let dy = direction.y.to_pt();
+    let length = dx * dx + dy * dy;
+    let t = if length > 0.0 {
+        ((relative.x.to_pt() * dx + relative.y.to_pt() * dy) / length).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    (point - (edge[0] + direction * t)).hypot().to_pt()
+}
+
+fn normalized_box(page_index: usize, size: Size, points: &[Point]) -> Option<PreviewTextBox> {
+    let width = renderer_page_extent(size.x)?;
+    let height = renderer_page_extent(size.y)?;
+    let mut left = f64::INFINITY;
+    let mut right = f64::NEG_INFINITY;
+    let mut top = f64::INFINITY;
+    let mut bottom = f64::NEG_INFINITY;
+    for point in points {
+        let x = point.x.to_pt();
+        let y = point.y.to_pt();
+        if !x.is_finite() || !y.is_finite() {
+            return None;
+        }
+        left = left.min(x);
+        right = right.max(x);
+        top = top.min(y);
+        bottom = bottom.max(y);
+    }
+    if right < 0.0 || left > width || bottom <= 0.0 || top >= height {
+        return None;
+    }
+    let x = (left / width).clamp(0.0, 1.0);
+    let y = (top / height).clamp(0.0, 1.0);
+    let right = (right / width).clamp(0.0, 1.0);
+    let bottom = (bottom / height).clamp(0.0, 1.0);
+    if bottom <= y {
+        return None;
+    }
+    Some(PreviewTextBox {
+        page_index,
+        x,
+        y,
+        width: right - x,
+        height: bottom - y,
+    })
+}
+
+fn same_box(a: &PreviewTextBox, b: &PreviewTextBox) -> bool {
+    a.page_index == b.page_index
+        && (a.x - b.x).abs() < 1e-10
+        && (a.y - b.y).abs() < 1e-10
+        && (a.width - b.width).abs() < 1e-10
+        && (a.height - b.height).abs() < 1e-10
+}
+
+fn position_to_offset(
+    source: &Source,
+    encoding: PositionEncoding,
+    position: LspPosition,
+) -> Option<usize> {
+    let start = source.lines().line_to_byte(position.line as usize)?;
+    let end = source
+        .lines()
+        .line_to_byte(position.line as usize + 1)
+        .unwrap_or(source.text().len());
+    let line = source
+        .text()
+        .get(start..end)?
+        .trim_end_matches(['\r', '\n']);
+    let requested = position.character as usize;
+    match encoding {
+        PositionEncoding::Utf8 => (requested <= line.len() && line.is_char_boundary(requested))
+            .then_some(start + requested),
+        PositionEncoding::Utf16 => {
+            let mut units = 0;
+            for (offset, ch) in line.char_indices() {
+                if units == requested {
+                    return Some(start + offset);
+                }
+                units += ch.len_utf16();
+                if units > requested {
+                    return None;
+                }
+            }
+            (units == requested).then_some(start + line.len())
+        }
+    }
+}
+
+fn offset_to_position(
+    source: &Source,
+    encoding: PositionEncoding,
+    offset: usize,
+) -> Option<LspPosition> {
+    if !source.text().is_char_boundary(offset) {
+        return None;
+    }
+    let line = source.lines().byte_to_line(offset)?;
+    let start = source.lines().line_to_byte(line)?;
+    let prefix = source.text().get(start..offset)?;
+    let character = match encoding {
+        PositionEncoding::Utf8 => prefix.len(),
+        PositionEncoding::Utf16 => prefix.encode_utf16().count(),
+    };
+    Some(LspPosition::new(
+        u32::try_from(line).ok()?,
+        u32::try_from(character).ok()?,
+    ))
+}
+
+fn is_rtl_or_bidi_control(ch: char) -> bool {
+    matches!(ch as u32, 0x0590..=0x08ff | 0xfb1d..=0xfdff | 0xfe70..=0xfefc | 0x10800..=0x10fff | 0x1e800..=0x1eeff | 0x200e..=0x200f | 0x202a..=0x202e | 0x2066..=0x2069)
+}
+
+/// OpenType GDEF LigCaretList. Format-1 coordinates are real font geometry;
+/// point-index/device/variation carets require information this API does not
+/// have, and are rejected. No equal-width subdivision is ever used.
+fn ligature_carets(text: &TextItem, glyph: &Glyph, count: usize) -> Option<Vec<f64>> {
+    let data = text
+        .font
+        .ttf()
+        .raw_face()
+        .table(ttf_parser::Tag::from_bytes(b"GDEF"))?;
+    let list = usize::from(read_u16(data, 8)?);
+    if list == 0 {
+        return None;
+    }
+    let coverage = list.checked_add(usize::from(read_u16(data, list)?))?;
+    let index = coverage_index(data, coverage, glyph.id)?;
+    if index >= usize::from(read_u16(data, list + 2)?) {
+        return None;
+    }
+    let ligature = list.checked_add(usize::from(read_u16(data, list + 4 + index * 2)?))?;
+    if usize::from(read_u16(data, ligature)?) != count {
+        return None;
+    }
+    let mut result = Vec::with_capacity(count);
+    for index in 0..count {
+        let caret = ligature.checked_add(usize::from(read_u16(data, ligature + 2 + index * 2)?))?;
+        if read_u16(data, caret)? != 1 {
+            return None;
+        }
+        let coordinate = read_u16(data, caret + 2)? as i16;
+        result.push(text.font.to_em(coordinate).at(text.size).to_pt());
+    }
+    result.sort_by(f64::total_cmp);
+    if result.windows(2).any(|pair| pair[0] >= pair[1]) {
+        return None;
+    }
+    Some(result)
+}
+
+fn read_u16(data: &[u8], offset: usize) -> Option<u16> {
+    Some(u16::from_be_bytes(
+        data.get(offset..offset.checked_add(2)?)?.try_into().ok()?,
+    ))
+}
+
+fn coverage_index(data: &[u8], offset: usize, glyph: u16) -> Option<usize> {
+    let count = usize::from(read_u16(data, offset + 2)?);
+    match read_u16(data, offset)? {
+        1 => (0..count).find(|index| read_u16(data, offset + 4 + index * 2) == Some(glyph)),
+        2 => {
+            for index in 0..count {
+                let at = offset + 4 + index * 6;
+                let start = read_u16(data, at)?;
+                let end = read_u16(data, at + 2)?;
+                if (start..=end).contains(&glyph) {
+                    return usize::from(read_u16(data, at + 4)?)
+                        .checked_add(usize::from(glyph - start));
+                }
+            }
+            None
+        }
+        _ => None,
+    }
+}
