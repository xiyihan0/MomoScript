+        byte_length: usize,
+        page_count: usize,
+    },
+    #[serde(rename = "resync")]
+    Resync {
+        protocol_version: &'static str,
+        session_id: String,
+        snapshot_token: String,
+        expected_base_generation: Option<u64>,
+    },
+    #[serde(rename = "locatedPoint")]
+    LocatedPoint {
+        protocol_version: &'static str,
+        session_id: String,
+        generation: u64,
+        location: Option<PreviewLocationResponse>,
+    },
+    #[serde(rename = "locatedSource")]
+    LocatedSource {
+        protocol_version: &'static str,
+        session_id: String,
+        generation: u64,
+        locations: Vec<SourceLocationResponse>,
+    },
+    #[serde(rename = "unavailable")]
+    Unavailable {
+        protocol_version: &'static str,
+        session_id: String,
+        generation: u64,
+    },
+    #[serde(rename = "committed")]
+    Committed {
+        protocol_version: &'static str,
+        session_id: String,
+        snapshot_token: String,
+        generation: u64,
+    },
+    #[serde(rename = "discarded")]
+    Discarded {
+        protocol_version: &'static str,
+        session_id: String,
+        snapshot_token: String,
+        generation: u64,
+    },
+    #[serde(rename = "closed")]
+    Closed {
+        protocol_version: &'static str,
+        session_id: String,
+    },
+}
+
+pub(crate) struct PreviewRendererState {
+    sessions: HashMap<String, PreviewRendererSession>,
+    file_records: HashMap<String, CachedPreviewFile>,
+    file_record_bytes: usize,
+    clock: u64,
+}
+
+struct PreviewRendererSession {
+    registered: Option<RegisteredPreviewProject>,
+    live_world: Option<LspWorld>,
+    base_font_resolver: Option<Arc<FontResolverImpl>>,
+    mount_digests: HashMap<PathBuf, String>,
+    mount_byte_lengths: HashMap<PathBuf, usize>,
+    font_digests: Vec<String>,
+    committed_renderer: Option<IncrSvgDocServer>,
+    staged_renderer: Option<IncrSvgDocServer>,
+    committed: Option<PreviewRendererGeneration>,
+    staged: Option<StagedPreviewRendererGeneration>,
+    last_used: u64,
+}
+
+#[derive(Clone)]
+struct RegisteredPreviewProject {
+    compiler_entry_uri: Url,
+    render_entry_uri: Url,
+    source_digest: String,
+}
+
+#[derive(Clone)]
+struct RegisteredPreviewMount {
+    path: PathBuf,
+    content_digest: String,
+}
+
+struct CachedPreviewFile {
+    bytes: Bytes,
+    byte_length: usize,
+    last_used: u64,
+}
+
+#[derive(Clone)]
+struct PreviewRendererGeneration {
+    snapshot_token: String,
+    source_digest: String,
+    artifact_digest: String,
+    compiler_revision: usize,
+    generation: u64,
+    page_count: usize,
+    artifact: LspCompiledArtifact,
+    entry_uri: Url,
+}
