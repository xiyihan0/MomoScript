+//! Exact, generation-local text geometry. This is deliberately independent of
+//! navigation's best-effort AST jumps: a source boundary is returned only when a
+//! compiled glyph cluster proves its relationship to a literal source span.
+
+use std::collections::HashMap;
+use std::fmt::{self, Write as _};
+use std::ops::Range;
+
+use lsp_types::{Position as LspPosition, Range as LspRange, Url};
+use serde::{Deserialize, Deserializer, Serialize};
+use tinymist_project::LspWorld;
+use tinymist_query::{path_res_to_url, PositionEncoding};
+use tinymist_std::typst::TypstDocument;
+use typst::{
+    foundations::{Str, Value},
+    introspection::{MetadataElem, Tag},
+    layout::{Abs, Frame, FrameItem, Point, Size, Transform},
+    syntax::{ast, ast::AstNode, FileId, LinkedNode, Side, Source, Span, SyntaxKind},
+    text::{Glyph, TextItem},
+    visualize::{Curve, CurveItem},
+    World,
+};
+
+use crate::{as_path_, preview_location::PreviewPoint};
+
+// The incremental SVG renderer lowers geometry to f32, then uses distinct
+// shortest, three-decimal, and two-decimal SVG representations. Hit testing
+// replays those representations; caret stops remain the compiled f64 edges.
+const SVG_TEXT_METRIC_SCALE: f64 = 16.0;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum PreviewCaretAffinity {
+    Before,
+    After,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct PreviewRendererPointUncertainty {
+    pub(crate) x: f64,
+    pub(crate) y: f64,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct PreviewTextHit {
+    pub(crate) uri: Url,
+    pub(crate) range: LspRange,
+    pub(crate) affinity: PreviewCaretAffinity,
+}
+
+#[derive(Clone, Debug, Serialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct PreviewTextBox {
+    pub(crate) page_index: usize,
+    pub(crate) x: f64,
+    pub(crate) y: f64,
+    pub(crate) width: f64,
+    pub(crate) height: f64,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct PreviewTextCaret {
+    #[serde(flatten)]
+    pub(crate) rect: PreviewTextBox,
+    pub(crate) affinity: PreviewCaretAffinity,
+}
+
+// lsp-types intentionally accepts extension fields. These renderer requests do
+// not: in particular an untrusted caller cannot smuggle a second position into
+// a nested record and have different transports interpret it differently.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ExactPosition {
+    line: u32,
+    character: u32,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ExactRange {
+    start: ExactPosition,
+    end: ExactPosition,
+}
+
+pub(crate) fn deserialize_position<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<LspPosition, D::Error> {
+    let value = ExactPosition::deserialize(deserializer)?;
+    Ok(LspPosition::new(value.line, value.character))
+}
+
+pub(crate) fn deserialize_range<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<LspRange, D::Error> {
+    let value = ExactRange::deserialize(deserializer)?;
+    Ok(LspRange::new(
+        LspPosition::new(value.start.line, value.start.character),
+        LspPosition::new(value.end.line, value.end.character),
+    ))
+}
+
+pub(crate) enum PreviewTextQuery {
+    HitTest(PreviewPoint, PreviewRendererPointUncertainty),
+    Caret(Url, LspPosition, PreviewCaretAffinity),
+    Range(Url, LspRange),
+}
+
+pub(crate) struct PreviewTextGeometry {
+    sources: HashMap<FileId, GeometrySource>,
+    pages: Vec<GeometryPage>,
+}
+
+struct GeometrySource {
+    source: Source,
+    uri: Url,
+}
+
+struct GeometryPage {
+    size: Size,
+    clusters: Vec<TextCluster>,
+}
+
+/// Both edges are in page points, including every enclosing group transform.
+/// Unknown clusters are retained as hit-test obstructions, not silently skipped
+/// to authorize text painted underneath an unassignable glyph.
+struct TextCluster {
+    left: [Point; 2],
+    right: [Point; 2],
+    baseline: [Point; 2],
+    rendered_left: [Point; 2],
+    rendered_right: [Point; 2],
+    rendered_seams: Vec<[Point; 2]>,
+    mapped: Option<MappedCluster>,
+    marker_band: Option<MarkerBand>,
+}
+
+#[derive(Clone, Copy)]
+struct ScalarInterval {
+    lo: f64,
+    hi: f64,
+}
+
+struct HitTestPoint {
+    point: Point,
+    x: ScalarInterval,
+    y: ScalarInterval,
+}
+
+struct MappedCluster {
+    id: FileId,
+    span: Span,
+    source: Range<usize>,
+    marker: bool,
+    starts_grapheme: bool,
+    ends_grapheme: bool,
+    stops: Vec<CaretStop>,
+}
+
+#[derive(Clone, Copy)]
+struct BodyBounds {
+    inverse: Transform,
+    size: Size,
+}
+
+struct MarkerBand {
+    body: BodyBounds,
+    inverse: Transform,
+    height: Abs,
+}
+
+struct CaretStop {
+    offset: usize,
+    edge: [Point; 2],
+    // Interior font-defined ligature carets support either affinity.
+    affinity: Option<PreviewCaretAffinity>,
+}
+
+/// Exact decoded-byte -> source-byte boundaries for one literal. There is no
+/// substring search: glyph.span.1 indexes this precise source node's value.
+struct TextOrigin {
+    id: FileId,
+    text: String,
+    boundaries: Vec<(usize, usize)>,
+    graphemes: Vec<usize>,
+}
+
+struct GeometryBuilder<'a> {
+    world: &'a LspWorld,
+    entry_uri: &'a Url,
+    sources: HashMap<FileId, GeometrySource>,
+    origins: HashMap<Span, Option<TextOrigin>>,
+}
+
+impl PreviewTextGeometry {
+    pub(crate) fn new(world: &LspWorld, document: &TypstDocument, entry_uri: &Url) -> Option<Self> {
+        let TypstDocument::Paged(document) = document else {
+            return None;
+        };
+        let mut builder = GeometryBuilder {
+            world,
+            entry_uri,
+            sources: HashMap::new(),
+            origins: HashMap::new(),
+        };
+        let mut pages = Vec::with_capacity(document.pages().len());
+        for page in document.pages() {
+            let mut geometry = GeometryPage {
+                size: page.frame.size(),
+                clusters: Vec::new(),
+            };
+            let renderer_transform = RendererTransform::page(page.frame.size())?;
+            builder.frame(
+                &page.frame,
+                Transform::identity(),
+                renderer_transform,
+                None,
+                &mut geometry.clusters,
+            );
+            pages.push(geometry);
+        }
+        Some(Self {
+            sources: builder.sources,
+            pages,
+        })
+    }
+
+    pub(crate) fn hit_test(
+        &self,
+        position: PreviewPoint,
+        uncertainty: PreviewRendererPointUncertainty,
+        encoding: PositionEncoding,
+    ) -> Option<PreviewTextHit> {
+        let page = self.pages.get(position.page_index)?;
+        if !position.x.is_finite()
+            || !position.y.is_finite()
+            || !(0.0..=1.0).contains(&position.x)
+            || !(0.0..=1.0).contains(&position.y)
+            || !uncertainty.x.is_finite()
+            || !uncertainty.y.is_finite()
+            || !(0.0..=1.0).contains(&uncertainty.x)
+            || !(0.0..=1.0).contains(&uncertainty.y)
+        {
+            return None;
+        }
+        let rendered_y_offset = self
+            .pages
+            .get(..position.page_index)?
+            .iter()
+            .try_fold(0.0, |offset, page| {
+                Some(offset + renderer_page_extent(page.size.y)?)
+            })?;
+        let point = HitTestPoint::new(position, uncertainty, page.size, rendered_y_offset)?;
+        let mut best: Option<(FileId, &CaretStop, f64)> = None;
+        for cluster in &page.clusters {
+            if !cluster.contains(&point) {
+                continue;
+            }
+            let mapped = cluster.mapped.as_ref()?;
+            let mut nearest: Option<(&CaretStop, f64)> = None;
+            for stop in &mapped.stops {
+                let distance = distance_to_edge(point.point, stop.edge);
+                if nearest.as_ref().is_none_or(|(_, old)| distance < *old) {
+                    nearest = Some((stop, distance));
+                }
+            }
+            let (stop, distance) = nearest?;
+            if let Some((id, old, old_distance)) = &best {
+                // Overlapping glyphs from distinct sources are not reversible.
+                // Ordinary neighbouring glyphs agree at their shared edge.
+                if *id != mapped.id || old.offset != stop.offset {
+                    return None;
+                }
+                if distance >= *old_distance {
+                    continue;
+                }
+            }
+            best = Some((mapped.id, stop, distance));
+        }
+        let (id, stop, _) = best?;
+        let source = self.sources.get(&id)?;
+        let position = offset_to_position(&source.source, encoding, stop.offset)?;
+        Some(PreviewTextHit {
+            uri: source.uri.clone(),
+            range: LspRange::new(position, position),
+            affinity: stop.affinity.unwrap_or(PreviewCaretAffinity::Before),
+        })
+    }
+
+    pub(crate) fn caret(
+        &self,
+        world: &LspWorld,
+        uri: &Url,
+        position: LspPosition,
+        affinity: PreviewCaretAffinity,
+        encoding: PositionEncoding,
+    ) -> Vec<PreviewTextCaret> {
+        let Some(id) = world.id_for_path(as_path_(uri).as_path()) else {
+            return Vec::new();
+        };
+        let Some(source) = self.sources.get(&id) else {
+            return Vec::new();
+        };
+        let Some(offset) = position_to_offset(&source.source, encoding, position) else {
+            return Vec::new();
+        };
+        self.caret_at(id, offset, affinity)
+    }
+
+    fn caret_at(
+        &self,
+        id: FileId,
+        offset: usize,
+        affinity: PreviewCaretAffinity,
+    ) -> Vec<PreviewTextCaret> {
+        let mut preferred = Vec::new();
+        let mut other = Vec::new();
+        for (page_index, page) in self.pages.iter().enumerate() {
+            for cluster in &page.clusters {
+                let Some(mapped) = &cluster.mapped else {
+                    continue;
+                };
+                if mapped.id != id {
+                    continue;
+                }
+                for stop in &mapped.stops {
+                    if stop.offset != offset {
+                        continue;
+                    }
+                    let Some(rect) = normalized_box(page_index, page.size, &stop.edge) else {
+                        continue;
+                    };
+                    let target = if stop.affinity.is_none_or(|value| value == affinity) {
+                        &mut preferred
+                    } else {
+                        &mut other
+                    };
+                    if !target
+                        .iter()
+                        .any(|caret: &PreviewTextCaret| same_box(&caret.rect, &rect))
+                    {
+                        target.push(PreviewTextCaret { rect, affinity });
+                    }
+                }
+            }
+        }
+        // At a soft wrap, before selects the following line and after selects
+        // the preceding line. At document endpoints only one side exists.
+        if preferred.is_empty() {
+            other
+        } else {
+            preferred
+        }
+    }
+
+    pub(crate) fn range(
+        &self,
+        world: &LspWorld,
+        uri: &Url,
+        range: LspRange,
+        encoding: PositionEncoding,
+    ) -> Vec<PreviewTextBox> {
+        let Some(id) = world.id_for_path(as_path_(uri).as_path()) else {
+            return Vec::new();
+        };
+        let Some(source) = self.sources.get(&id) else {
+            return Vec::new();
+        };
+        let Some(start) = position_to_offset(&source.source, encoding, range.start) else {
+            return Vec::new();
+        };
+        let Some(end) = position_to_offset(&source.source, encoding, range.end) else {
+            return Vec::new();
+        };
+        self.range_at(id, start..end)
+    }
+
+    fn range_at(&self, id: FileId, range: Range<usize>) -> Vec<PreviewTextBox> {
+        if range.start > range.end {
+            return Vec::new();
+        }
+        let mut result = Vec::new();
+        let mut found_start = false;
+        let mut found_end = false;
+        for (page_index, page) in self.pages.iter().enumerate() {
+            for cluster in &page.clusters {
+                let Some(mapped) = &cluster.mapped else {
+                    continue;
+                };
+                if mapped.id != id {
+                    continue;
+                }
+                found_start |= mapped.stops.iter().any(|stop| stop.offset == range.start);
+                found_end |= mapped.stops.iter().any(|stop| stop.offset == range.end);
+                if mapped.marker
+                    && range.start <= mapped.source.start
+                    && mapped.source.start <= range.end
+                {
+                    if let Some(rect) = normalized_box(page_index, page.size, &cluster.left) {
+                        if !result.iter().any(|old| same_box(old, &rect)) {
+                            result.push(rect);
+                        }
+                    }
+                    continue;
+                }
+                let start = range.start.max(mapped.source.start);
+                let end = range.end.min(mapped.source.end);
+                if start >= end {
+                    continue;
+                }
+                let start_edge = if start == mapped.source.start {
+                    Some(cluster.source_edge(false))
+                } else {
+                    mapped
+                        .stops
+                        .iter()
+                        .find(|stop| stop.offset == start)
+                        .map(|stop| stop.edge)
+                };
+                let end_edge = if end == mapped.source.end {
+                    Some(cluster.source_edge(true))
+                } else {
+                    mapped
+                        .stops
+                        .iter()
+                        .find(|stop| stop.offset == end)
+                        .map(|stop| stop.edge)
+                };
+                let (Some(a), Some(b)) = (start_edge, end_edge) else {
+                    // Do not paint an entire ligature for a partial range when
+                    // its font does not provide a real interior caret.
+                    return Vec::new();
+                };
+                if let Some(rect) = normalized_box(page_index, page.size, &[a[0], a[1], b[0], b[1]])
+                {
+                    if !result.iter().any(|old| same_box(old, &rect)) {
+                        result.push(rect);
+                    }
+                }
+            }
+        }
+        if found_start && found_end {
+            result
+        } else {
+            Vec::new()
+        }
+    }
+}
